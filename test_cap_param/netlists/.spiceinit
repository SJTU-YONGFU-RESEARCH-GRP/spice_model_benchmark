* .spiceinit for use with Skywater PDK and IHPi
set ngbehavior=hsa     ; set compatibility for reading PDK libs
set skywaterpdk        ; skip some checks for faster lib loading
set ng_nomodcheck      ; don't check the model parameters
set num_threads=8      ; CPU processor cores available

* Better convergence options instead of forcing transient OP  
option gmin=1e-12      ; minimum conductance for better convergence
option abstol=1e-12    ; absolute tolerance
option reltol=1e-3     ; relative tolerance  
option vntol=1e-3      ; voltage tolerance
option itl1=300        ; DC iteration limit
option itl2=300        ; DC transfer curve iteration limit
option itl4=50         ; transient analysis iteration limit
option pivrel=1e-3     ; relative pivot threshold
option pivtol=1e-9     ; absolute pivot threshold

* Use sparse solver (not always KLU - let ngspice choose)
* option klu             ; select KLU as matrix solver (commented out)

* Numparam error handling
set numparam_continue=1

* Add IHP model paths (disabled for FreePDK45-only runs)
* setcs sourcepath = ( $sourcepath ../models/IHP-Open-PDK/ihp-sg13g2/libs.tech/ngspice/models )

* Load OSDI models (commented out to avoid errors when binaries are missing)
* osdi '../models/IHP-Open-PDK/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi'
* osdi '../models/IHP-Open-PDK/ihp-sg13g2/libs.tech/ngspice/osdi/psp103_nqs.osdi'
* osdi '../models/IHP-Open-PDK/ihp-sg13g2/libs.tech/ngspice/osdi/r3_cmc.osdi'
