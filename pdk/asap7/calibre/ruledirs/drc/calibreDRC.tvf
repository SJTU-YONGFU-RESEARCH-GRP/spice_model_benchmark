#! tvf
global env

::tvf::LAYOUT PATH \"$::env(LAYOUT_PATH)\"
::tvf::LAYOUT SYSTEM $::env(LAYOUT_SYSTEM)
::tvf::LAYOUT PRIMARY \"*\"

::tvf::DRC MAXIMUM RESULTS ALL
::tvf::DRC RESULTS DATABASE \"$::env(DRC_DATABASE)\"
::tvf::DRC SUMMARY REPORT \"$::env(DRC_REPORT)\"

::tvf::DRC ICSTATION YES

::tvf::INCLUDE \"$::env(PDK_DIR)/calibre/ruledirs/drc/drcRules_calibre_asap7.rul\"

