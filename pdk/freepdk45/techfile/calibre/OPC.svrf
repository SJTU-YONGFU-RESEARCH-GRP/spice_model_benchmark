opc_metal1 = LITHO DENSEOPC FILE metal1_in metal1 MAP metal1_opc
opc_metal1 {COPY opc_metal1} DRC CHECK MAP opc_metal1 oasis 111 metal1_opc_out.oas
LITHO FILE metal1_in [
modelpath $env(PDK_DIR)/ncsu_basekit/techfile/calibre/models/metal_contact
optical_model_load opticalD0 opticalD0 
optical_model_load opticalD10 opticalD10
resist_model_load vt5out vt5out.mod 
background atten 0.06
layer metal1 hidden clear
denseopc_options dopc {
version 1
background atten 0.06
layer metal1 opc clear
image optical opticalD0 resist vt5out 
#pw_condition c1 optical opticalD10 dose 1.5 resist vt5out  
scale 1.23
#corner_control 0.68

}
setlayer metal1_opc = denseopc metal1 MAP metal1 OPTIONS dopc
]

opc_contact = LITHO DENSEOPC FILE contact_in contact MAP contact_opc
opc_contact {COPY opc_contact} DRC CHECK MAP opc_contact oasis 111 contact_opc_out.oas
LITHO FILE contact_in [
modelpath $env(PDK_DIR)/ncsu_basekit/techfile/calibre/models/metal_contact
optical_model_load opticalD0 opticalD0
resist_model_load vt5out vt5out.mod 
background atten 0.06
layer contact hidden clear
denseopc_options dopc {
version 1
background atten 0.06
layer contact opc clear
image optical opticalD0 resist vt5out
}
setlayer contact_opc = denseopc contact MAP contact OPTIONS dopc
]

opc_poly = LITHO DENSEOPC FILE poly_in poly MAP poly_opc
opc_poly {COPY opc_poly} DRC CHECK MAP opc_poly oasis 111 poly_opc_out.oas
LITHO FILE poly_in [
modelpath $env(PDK_DIR)/ncsu_basekit/techfile/calibre/models/poly_active
optical_model_load opticalD0 opticalD0
resist_model_load vt5out vt5out.mod 
background clear
layer poly hidden atten 0.06
denseopc_options dopc {
version 1
background clear
layer poly opc atten 0.06
image optical opticalD0 resist vt5out
scale 1.52
}
setlayer poly_opc = denseopc poly MAP poly OPTIONS dopc
]

opc_active = LITHO DENSEOPC FILE active_in active MAP active_opc
opc_active {COPY opc_active} DRC CHECK MAP opc_active oasis 111 active_opc_out.oas
LITHO FILE active_in [
modelpath $env(PDK_DIR)/ncsu_basekit/techfile/calibre/models/poly_active
optical_model_load opticalD0 opticalD0
resist_model_load vt5out vt5out.mod 
background clear
layer active hidden atten 0.06
denseopc_options dopc {
version 1
background clear
layer active opc atten 0.06
image optical opticalD0 resist vt5out

}
setlayer active_opc = denseopc active MAP active OPTIONS dopc
]
