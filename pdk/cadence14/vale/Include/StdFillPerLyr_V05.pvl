  #ELSE
   #IFDEF $SELECT_IN_DESIGN_FLOW FALSE
    #UNDEFINE UseInDesignFlow
   #ELSE
    #IFDEF $SELECT_IN_DESIGN_FLOW NO
     #UNDEFINE UseInDesignFlow
    #ELSE
     #IFDEF $SELECT_IN_DESIGN_FLOW DEFAULT
      #UNDEFINE UseInDesignFlow
     #ELSE
      #IFDEF $SELECT_IN_DESIGN_FLOW
       pvl_error "Environment variable SELECT_IN_DESIGN_FLOW is defined, but has no value.  Please use TRUE, FALSE, YES, NO, or DEFAULT.";
      #ELSE
       #UNDEFINE UseInDesignFlow
       pvl_message "SELECT_IN_DESIGN_FLOW set to default value NO";
      #ENDIF
     #ENDIF
    #ENDIF
   #ENDIF
  #ENDIF
 #ENDIF
#endif

PVS_READ_TCL_BLOCK

if { ! [info exists ::env(BEOL_STACK)] } {
   puts "pvl_message \"WARNING: Environment variable BEOL_STACK is not set.\"" 
   puts "pvl_message \"WARNING: Using default value 8M_7Mx_MT.\"" 
   set ::env(BEOL_STACK) stack1
}

switch $::env(BEOL_STACK) {
   stack1 -
   8M_7Mx_MT {
      set ::env(BEOL_STACK) stack1
   }
   stack2 -
   10M_9Mx_MT {
      set ::env(BEOL_STACK) stack2
   }
   default {
      puts "pvl_error \"Environment variable BEOL_STACK must be set.\"" 
   }
}

PVS_END_TCL_BLOCK

#ifdef $BEOL_STACK stack1
variable BEOL_STACK stack1
#endif

#ifdef $BEOL_STACK stack2
variable BEOL_STACK stack2
#endif

#ifdef $FILL_EDGE_HALO
variable FILL_EDGE_HALO environment ;
#else
variable FILL_EDGE_HALO 0.0 ;
#endif


