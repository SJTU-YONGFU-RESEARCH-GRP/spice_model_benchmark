if {![info exists ::env(CRITICAL_NET_FILE)]} {
   puts "
   // default 2x min space
   variable M1_CRITNET_DIST 0.124
   variable M2_CRITNET_DIST 0.124
   variable M3_CRITNET_DIST 0.124
   variable M4_CRITNET_DIST 0.124
   variable M5_CRITNET_DIST 0.148
   variable M6_CRITNET_DIST 0.148
   variable M7_CRITNET_DIST 0.196
   variable MT_CRITNET_DIST 0.384
   "
} else {
   puts "
   include \$CRITICAL_NET_FILE ;
   "
}
PVS_END_TCL_BLOCK
#else
PVS_READ_TCL_BLOCK
set ::env(SELECT_CRITICAL_NET_FEATURE) 0
PVS_END_TCL_BLOCK
#endif

