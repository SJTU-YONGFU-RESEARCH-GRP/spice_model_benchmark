antenna M5all M1_CRITEXCL -gt 0 -outputlayer M5selByM1ce ;
antenna M6all M1_CRITEXCL -gt 0 -outputlayer M6selByM1ce ;
antenna M7all M1_CRITEXCL -gt 0 -outputlayer M7selByM1ce ;
