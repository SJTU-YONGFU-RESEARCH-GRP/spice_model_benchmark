//-----------------------------------------------------------------------------
// Object Definitions
//-----------------------------------------------------------------------------

layer_def prBoundary  1300;
 layer_map 1000 -datatype eq  0 1300;

//-----------------------------------------------------------------------------
// LAYER DERIVATIONS
//-----------------------------------------------------------------------------

PVS_READ_TCL_BLOCK
proc GPDKprocessDPLayer {lyr out1 out2 outAll} {
   puts "
   or (or ${lyr}_MASK1_UNLOCK ${lyr}_MASK1_LOCK) \
      (or ${lyr}_FILL_MASK1_UNLOCK ${lyr}_FILL_MASK1_LOCK) ${lyr}color1pre ;
   or (or ${lyr}_MASK2_UNLOCK ${lyr}_MASK2_LOCK) \
      (or ${lyr}_FILL_MASK2_UNLOCK ${lyr}_FILL_MASK2_LOCK) ${lyr}color2pre ;
   or ${lyr}color1pre ${lyr}color2pre ${lyr}colored ;
   not ${lyr} ${lyr}colored ${lyr}gray ;
   select -interact ${lyr}gray ${lyr}color1pre ${lyr}grayXcolor1 ;
   select -not -interact ${lyr}gray ${lyr}color1pre ${lyr}grayYcolor1 ;
   select -interact ${lyr}gray ${lyr}color2pre ${lyr}grayXcolor2 ;
   select -not -interact ${lyr}gray ${lyr}color2pre ${lyr}grayYcolor2 ;
   and ${lyr}grayXcolor1 ${lyr}grayYcolor2 ${lyr}gray2color1 ;
   and ${lyr}grayXcolor2 ${lyr}grayYcolor1 ${lyr}gray2color2 ;
   not ${lyr}gray (or ${lyr}gray2color1 ${lyr}gray2color2) ${lyr}grayIso ;
   rule mrk-${lyr}-FILL--NoColor {
      caption WARNING: Layer ${lyr} shape has no color.  Added to the color2 set for processing.;
      copy ${lyr}grayIso ;
   }
   or ${lyr}color1pre ${lyr}gray2color1 $out1 ;
   cat ${lyr}color2pre ${lyr}gray2color2 ${lyr}grayIso $out2 ;
   or ${lyr}color1 ${lyr}color2 $outAll ;
   "
}

GPDKprocessDPLayer M1 M1color1 M1color2 M1all
GPDKprocessDPLayer M2 M2color1 M2color2 M2all
GPDKprocessDPLayer M3 M3color1 M3color2 M3all

PVS_END_TCL_BLOCK

or V1_MASK1_UNLOCK V1_MASK1_LOCK V1color1 ;
or V1_MASK2_UNLOCK V1_MASK2_LOCK V1color2 ;
or V1_MASK3_UNLOCK V1_MASK3_LOCK V1color3 ;
or (or V1color1 V1color2) V1color3 V1colored ;
or V1 V1colored V1all ;

or V2_MASK1_UNLOCK V2_MASK1_LOCK V2color1 ;
or V2_MASK2_UNLOCK V2_MASK2_LOCK V2color2 ;
or V2_MASK3_UNLOCK V2_MASK3_LOCK V2color3 ;
or (or V2color1 V2color2) V2color3 V2colored ;
or V2 V2colored V2all ;

or V3_MASK1_UNLOCK V3_MASK1_LOCK V3color1 ;
or V3_MASK2_UNLOCK V3_MASK2_LOCK V3color2 ;
or V3_MASK3_UNLOCK V3_MASK3_LOCK V3color3 ;
or (or V3color1 V3color2) V3color3 V3colored ;
or V3 V3colored V3all ;

cat  M4 M4_FILL M4all ;
copy V4 V4all ;
cat  M5 M5_FILL M5all ;
copy V5 V5all ;
cat  M6 M6_FILL M6all ;
copy V6 V6all ;
cat  M7 M7_FILL M7all ;
copy VT VTall ;
cat  MT MT_FILL MTall ;

