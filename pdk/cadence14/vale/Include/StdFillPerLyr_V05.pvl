  #ELSE
   #IFDEF $SELECT_PRBOUNDARY FALSE
    #UNDEFINE UseprBoundary
   #ELSE
    #IFDEF $SELECT_PRBOUNDARY NO
     #UNDEFINE UseprBoundary
    #ELSE
     #IFDEF $SELECT_PRBOUNDARY DEFAULT
      #DEFINE UseprBoundary
     #ELSE
      #IFDEF $SELECT_PRBOUNDARY
       pvl_error "Environment variable SELECT_PRBOUNDARY is defined, but has no value.  Please use TRUE, FALSE, YES, NO, or DEFAULT.";
      #ELSE
       #DEFINE UseprBoundary
       pvl_message "SELECT_PRBOUNDARY set to default value YES";
      #ENDIF
     #ENDIF
    #ENDIF
   #ENDIF
  #ENDIF
 #ENDIF
#endif

