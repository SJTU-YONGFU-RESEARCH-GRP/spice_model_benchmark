//-----------------------------------------------------------------------------
// Standard Fill Runset for the Advanced Node GPDK
//-----------------------------------------------------------------------------
layout_primary "midcell_1" ;
df2key enableColoring yes ;
exception_severity precision_rule_file 1 ;
exception_severity missing_rulecheck 0;
exception_severity polygon_nonorientable 4;
abort_on_layout_error no ;
//magnify_in auto ;
input_scale 2000 ;
grid 1;
report_summary -drc result.sum;
max_results -drc -all;
incr_conn yes;

//-----------------------------------------------------------------------------
// Environment Options
//-----------------------------------------------------------------------------

// Set design type
#ifndef GPDK_FILL_CONFIG
 #IFDEF $DESIGN_TYPE CHIP
  #DEFINE FULL_CHIP
 #ELSE
  #IFDEF $DESIGN_TYPE CELL
   #UNDEFINE FULL_CHIP 
  #ELSE
   #UNDEFINE FULL_CHIP
   pvl_message "DESIGN_TYPE set to default value CELL";
  #ENDIF
 #ENDIF
#endif

#IFDEF FULL_CHIP
// CHIP_FILL defined in group_rules command below
select_check CHIP_FILL ;
#ELSE
// CELL_FILL defined in group_rules command below
select_check CELL_FILL ;
#ENDIF

// Input data format
#ifndef GPDK_FILL_CONFIG
 #IFDEF $LAYOUT_SYSTEM OASIS
  #define LAYOUT_SYSTEM_OASIS
 #ELSE
  #IFDEF $LAYOUT_SYSTEM GDS
   #UNDEFINE LAYOUT_SYSTEM_OASIS
  #ELSE
   #IFDEF $LAYOUT_SYSTEM GDSII
    #UNDEFINE LAYOUT_SYSTEM_OASIS
   #ELSE
    #UNDEFINE LAYOUT_SYSTEM_OASIS
    pvl_message "LAYOUT_SYSTEM set to default value GDSII";
   #ENDIF
  #ENDIF
 #ENDIF
#endif

#ifdef LAYOUT_SYSTEM_OASIS
  layout_path "midcell_1.oas";
  layout_format oasis ;
  results_db -drc "output.oas" -oasis -pseudo;
#else
  layout_path "midcell_1.gds";
  layout_format gdsii ;
  results_db -drc "output.gds" -gdsii -pseudo;
#endif

// Output data format
#ifndef GPDK_FILL_CONFIG
 #IFDEF $OUTPUT_LAYOUT OASIS
  #define OUTPUT_LAYOUT_OASIS
 #ELSE
  #IFDEF $OUTPUT_LAYOUT GDS
   #UNDEFINE OUTPUT_LAYOUT_OASIS
  #ELSE
   #IFDEF $OUTPUT_LAYOUT GDSII
    #UNDEFINE OUTPUT_LAYOUT_OASIS
   #ELSE
    #UNDEFINE OUTPUT_LAYOUT_OASIS
    pvl_message "OUTPUT_LAYOUT set to default value GDSII";
   #ENDIF
  #ENDIF
 #ENDIF
#endif

#ifndef GPDK_FILL_CONFIG
 #IFDEF $SELECT_PRBOUNDARY TRUE
