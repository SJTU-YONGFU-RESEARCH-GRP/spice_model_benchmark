connect M3_CRITEXCL M3all ;
connect M4_CRITEXCL M4all ;
connect M5_CRITEXCL M5all ;
connect M6_CRITEXCL M6all ;
connect M7_CRITEXCL M7all ;
connect MT_CRITEXCL MTall ;
