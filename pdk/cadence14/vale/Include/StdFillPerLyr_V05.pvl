PVS_READ_TCL_BLOCK

proc GPDKgetFillVariables {layer} {
    if {$layer == "M1" || $layer == "M2" || $layer == "M3"} {
       puts "
       // The fill shape small rectangle length
       variable FSS_X1 0.256 ;
       // The fill shape small rectangle width
       variable FSS_Y1 0.032 ;
       // The x step for the fill shape small, 2x the length and 2x 0.064 space
       variable FSS_XSTEP 0.640 ;
       // The y step for the fill shape small, 2x the width and 2x 0.032 space
       variable FSS_YSTEP 0.128 ;
       // Amount to offset each row of the fill shape small
       variable FSS_XOFFSET 0.0 ;
       // Amount to offset each col of the fill shape small
       variable FSS_YOFFSET 0.012 ;
       // fill shape small spacing to Mx drawing of same color
       variable FSS_SP 0.072 ;
       // fill shape small spacing to current fill shape small shapes
       variable FSS_SPSELF 0.072 ;
       // fill shape small spacing to Mx exclude
       variable FSS_SPEX 0.072 ;
       // fill shape small spacing to Mx drawing of opposite color
       variable FSS_SPDC 0.048 ;
       // The fill shape medium rectangle length
       variable FSM_X1 0.128 ;
       // The fill shape medium rectangle width
       variable FSM_Y1 0.064 ;
       // The x step for the fill shape medium, 2x the length and 2x 0.064 space
       variable FSM_XSTEP 0.384 ;
       // The y step for the fill shape medium, 2x the width and 2x 0.032 space
       variable FSM_YSTEP 0.192 ;
       // Amount to offset each row of the fill shape medium 
       variable FSM_XOFFSET 0.0 ;
       // Amount to offset each col of the fill shape medium 
       variable FSM_YOFFSET 0.0 ;
       // fill shape medium spacing to Mx drawing of same color
       variable FSM_SP 0.072 ;
       // fill shape medium spacing to current fill shape medium shapes
       variable FSM_SPSELF 0.072 ;
       // fill shape medium spacing to Mx exclude
       variable FSM_SPEX 0.072 ;
       // fill shape medium spacing to Mx drawing of opposite color
       variable FSM_SPDC 0.048 ;
       "
    }
    if {$layer == "M4"} {
       puts "
       // The fill shape small rectangle length
       variable FSS_X1 0.256 ;
       // The fill shape small rectangle width
       variable FSS_Y1 0.032 ;
       // The x step for the fill shape small, 2x the length and 2x 0.064 space
       variable FSS_XSTEP 0.320 ;
       // The y step for the fill shape small, 2x the width and 2x 0.032 space
       variable FSS_YSTEP 0.064 ;
       // Amount to offset each row of the fill shape small
       variable FSS_XOFFSET 0.0 ;
       // Amount to offset each col of the fill shape small
       variable FSS_YOFFSET 0.012 ;
       // fill shape small spacing to Mx drawing of same color
       variable FSS_SP 0.072 ;
       // fill shape small spacing to current fill shape small shapes
       variable FSS_SPSELF 0.072 ;
       // fill shape small spacing to Mx exclude
       variable FSS_SPEX 0.072 ;
       // fill shape small spacing to Mx drawing of opposite color
       variable FSS_SPDC 0.048 ;
       // The fill shape medium rectangle length
       variable FSM_X1 0.128 ;
       // The fill shape medium rectangle width
       variable FSM_Y1 0.064 ;
       // The x step for the fill shape medium, 2x the length and 2x 0.064 space
       variable FSM_XSTEP 0.192 ;
       // The y step for the fill shape medium, 2x the width and 2x 0.032 space
       variable FSM_YSTEP 0.096 ;
       // Amount to offset each row of the fill shape medium 
       variable FSM_XOFFSET 0.0 ;
       // Amount to offset each col of the fill shape medium 
       variable FSM_YOFFSET 0.0 ;
       // fill shape medium spacing to Mx drawing of same color
       variable FSM_SP 0.072 ;
       // fill shape medium spacing to current fill shape medium shapes
       variable FSM_SPSELF 0.072 ;
       // fill shape medium spacing to Mx exclude
       variable FSM_SPEX 0.072 ;
       // fill shape medium spacing to Mx drawing of opposite color
       variable FSM_SPDC 0.048 ;
       "
    }
    if {$layer == "M5" || $layer == "M6"} {
       puts "
       // The fill shape small rectangle length
       variable FSS_X1 0.512 ;
       // The fill shape small rectangle width
       variable FSS_Y1 0.058 ;
       // The x step for the fill shape small
       variable FSS_XSTEP 0.640 ;
       // The y step for the fill shape small
       variable FSS_YSTEP 0.128 ;
       // Amount to offset each row of the fill shape small
       variable FSS_XOFFSET 0.0 ;
       // Amount to offset each col of the fill shape small
       variable FSS_YOFFSET 0.012 ;
       // fill shape small spacing to Mx drawing of same color
       variable FSS_SP 0.100 ;
       // fill shape small spacing to current fill shape small shapes
       variable FSS_SPSELF 0.100 ;
       // fill shape small spacing to Mx exclude
       variable FSS_SPEX 0.100 ;
       // fill shape small spacing to Mx drawing of opposite color
       variable FSS_SPDC 0.080 ;
       // The fill shape medium rectangle length
       variable FSM_X1 0.256 ;
       // The fill shape medium rectangle width
       variable FSM_Y1 0.100 ;
       // The x step for the fill shape medium
       variable FSM_XSTEP 0.384 ;
       // The y step for the fill shape medium
       variable FSM_YSTEP 0.192 ;
       // Amount to offset each row of the fill shape medium 
       variable FSM_XOFFSET 0.0 ;
       // Amount to offset each col of the fill shape medium 
       variable FSM_YOFFSET 0.0 ;
       // fill shape medium spacing to Mx drawing of same color
       variable FSM_SP 0.100 ;
       // fill shape medium spacing to current fill shape medium shapes
       variable FSM_SPSELF 0.100 ;
       // fill shape medium spacing to Mx exclude
       variable FSM_SPEX 0.100 ;
       // fill shape medium spacing to Mx drawing of opposite color
       variable FSM_SPDC 0.080 ;
       "
    }
    if {$layer == "M7"} {
       puts "
       // The fill shape small rectangle length
       variable FSS_X1 0.512 ;
       // The fill shape small rectangle width
       variable FSS_Y1 0.069 ;
       // The x step for the fill shape small
       variable FSS_XSTEP 0.640 ;
       // The y step for the fill shape small
       variable FSS_YSTEP 0.151 ;
       // Amount to offset each row of the fill shape small
       variable FSS_XOFFSET 0.0 ;
       // Amount to offset each col of the fill shape small
       variable FSS_YOFFSET 0.012 ;
       // fill shape small spacing to Mx drawing of same color
       variable FSS_SP 0.120 ;
       // fill shape small spacing to current fill shape small shapes
       variable FSS_SPSELF 0.120 ;
       // fill shape small spacing to Mx exclude
       variable FSS_SPEX 0.120 ;
       // fill shape small spacing to Mx drawing of opposite color
       variable FSS_SPDC 0.100 ;
       // The fill shape medium rectangle length
       variable FSM_X1 0.256 ;
       // The fill shape medium rectangle width
       variable FSM_Y1 0.100 ;
       // The x step for the fill shape medium
       variable FSM_XSTEP 0.384 ;
       // The y step for the fill shape medium
       variable FSM_YSTEP 0.256 ;
       // Amount to offset each row of the fill shape medium 
       variable FSM_XOFFSET 0.0 ;
       // Amount to offset each col of the fill shape medium 
       variable FSM_YOFFSET 0.0 ;
       // fill shape medium spacing to Mx drawing of same color
       variable FSM_SP 0.120 ;
       // fill shape medium spacing to current fill shape medium shapes
       variable FSM_SPSELF 0.120 ;
       // fill shape medium spacing to Mx exclude
       variable FSM_SPEX 0.120 ;
       // fill shape medium spacing to Mx drawing of opposite color
       variable FSM_SPDC 0.100 ;
       "
    }
    if {$layer == "MT"} {
       puts "
       // The fill shape small rectangle length
       variable FSS_X1 0.800 ;
       // The fill shape small rectangle width
       variable FSS_Y1 0.22 ;
       // The x step for the fill shape small
       variable FSS_XSTEP 0.640 ;
       // The y step for the fill shape small
       variable FSS_YSTEP 0.550 ;
       // Amount to offset each row of the fill shape small
       variable FSS_XOFFSET 0.0 ;
       // Amount to offset each col of the fill shape small
       variable FSS_YOFFSET 0.012 ;
       // fill shape small spacing to Mx drawing of same color
       variable FSS_SP 0.350 ;
       // fill shape small spacing to current fill shape small shapes
       variable FSS_SPSELF 0.350 ;
       // fill shape small spacing to Mx exclude
       variable FSS_SPEX 0.350 ;
       // fill shape small spacing to Mx drawing of opposite color
       variable FSS_SPDC 0.200 ;
       "
    }
    if {$layer == "Poly"} {
       puts "
       // The size of the instance fill box
       variable FIT_X1 0.515 ;
       variable FIT_Y1 0.256 ;
       // 1/2 the FIT_Y1 dimension 
       variable FIT_RESIZE 0.128 ;
       // The fill shape small rectangle width 
       variable FSS_X1 0.160 ;
       // The fill shape small rectangle length
       variable FSS_Y1 0.018 ;
       // The x step for the fill shape small, 1x the width and 1x 0.068 space
       variable FSS_XSTEP 0.280 ;
       // The y step for the fill shape small, 1x the width and 1x 0.120 space
       variable FSS_YSTEP 0.086 ;
       // Amount to offset each row of the fill shape small
       variable FSS_XOFFSET 0.0 ;
       // Amount to offset each col of the fill shape small
       variable FSS_YOFFSET 0.0 ;
       // fill shape spacing to other Poly
       variable FSS_SP 0.080 ;
       // fill shape spacing to current fill shapes
       variable FSS_SPSELF 0.120 ;
       // fill shape spacing to exclude  
       variable FSS_SPEX 0.080 ;
       // fill shape spacing 
       variable FSS_SPDC 0.120 ;
       "
    }
}

proc GPDKrunFill {baseLyr lyr isDP fillRgn doCritNet doFillInst} {
   ## Set Variables for Current Layer
   GPDKgetFillVariables $baseLyr 

   puts "and $lyr $fillRgn ${lyr}i ;"

   ###############################
   ## Use Critical Net Feature
   ###############################
   if {$doCritNet} {
      ## The Critical Net Feature is necessary to protect nets that are
      ## sensitive to the electrical impacts of a nearby net.  For a double
      ## patterned layer, the critical net exclude distance is applied
      ## as if there was no color on the net.
      puts "size ${baseLyr}ceSel -by ${baseLyr}_CRITNET_DIST ${lyr}_cnExcl ;"
      ## Subtract from the fill region to create the fill area 1 region
      puts "not $fillRgn ${lyr}_cnExcl ${lyr}fillArea1 ;"
   } else {
      puts "copy $fillRgn ${lyr}fillArea1 ;" 
   }

   ###############################
   ##  Use Fill Instance Feature
   ###############################
   if {$doFillInst} {
      puts "
      size ${lyr}i -by FIT_RESIZE -overunder ${lyr}sized ;
      //rule mrk-Poly-FILL--initialSizing {
      //   copy ${lyr}sized ;
      //}
      not ${lyr}fillArea1 ${lyr}sized ${lyr}initialFillRegion ;
      dfm_fill_pattern \"${lyr}inst___Rect\" -rect 0 0  FIT_X1 FIT_Y1 ;

      dfm_fill_spec \"${lyr}fillInstSpec\" \
         -inside_of_layer ${lyr}initialFillRegion \
         -pattern \"${lyr}inst___Rect\" -tag \"${lyr}inst___Rect\" \
            -step 0.0 0.256 \
            -repeat 1 \
            -offset 0.0 0.0 \
            -space FSS_SP $lyr \
            -fill_space 0.086 0.064 ;
      
      dfm_fill \"${lyr}fillInstSpec\" -select \"${lyr}inst___Rect\" \
         ${lyr}fiMarker ;
      not ${lyr}fillArea1 ${lyr}fiMarker ${lyr}fillArea2 ;
      "

      if {$lyr == "PolyALL"} {
         puts "
         // Use the fill instance marker as the exclude layer for Poly
         copy ${lyr}fiMarker ${lyr}_EXCLUDE ;
         // Custom region post-processing
         grow NWell -left 0.356 -right 0.356 NWellWide ;
         select -interact ${lyr}fiMarker NWellWide ${lyr}fiMarkerPtype ;
         not ${lyr}fiMarker ${lyr}fiMarkerPtype ${lyr}fiMarkerNtype ;
         rect_gen -width FIT_X1 -length FIT_Y1 -spacing 0.001 -inside_of_layer \
            ${lyr}fiMarkerPtype ${lyr}fiBoxPtype ;
         rect_gen -width FIT_X1 -length FIT_Y1 -spacing 0.001 -inside_of_layer \
            ${lyr}fiMarkerNtype ${lyr}fiBoxNtype ;
         //rule mrk-Poly-FILL--fillcell_p1 {
         //   copy ${lyr}fiBoxPtype ;
         //}
         //rule mrk-Poly-FILL--fillcell_n1 {
         //   copy ${lyr}fiBoxNtype ;
         //}
         "
      }

   } else {
      puts "copy ${lyr}fillArea1 ${lyr}fillArea2 ;"
      if {$lyr == "PolyALL"} {
         puts "empty_layer PolyALL_EXCLUDE ;"
      }
   }

   ## debug
   puts "
   //rule mrk-${lyr}-FILL--fillArea1 {
   //    copy ${lyr}fillArea1 ;
   //}
   //rule mrk-${lyr}-FILL--fillArea2 {
   //    copy ${lyr}fillArea2 ;
   //}
   "

   ###############################
   ##  Main Fill Shape Flow
   ###############################
   ## Swap horizontal and vertical parameters as needed
   if {$baseLyr == "M2" || $baseLyr == "M4" || 
       $baseLyr == "M6" || $baseLyr == "MT"} {
      puts "dfm_fill_pattern \"${lyr}small__Rect\" -rect 0 0  FSS_X1 FSS_Y1 ;"
      puts "dfm_fill_pattern \"${lyr}medium_Rect\" -rect 0 0  FSM_X1 FSM_Y1 ;"
   } else {
      puts "dfm_fill_pattern \"${lyr}small__Rect\" -rect 0 0  FSS_Y1 FSS_X1 ;"
      if {$lyr != "PolyALL" && $lyr != "MTall"} {
         puts "dfm_fill_pattern \"${lyr}medium_Rect\" -rect 0 0  FSM_Y1 FSM_X1 ;"
      }
   }

   puts "
   dfm_fill_spec \"${lyr}fillSpec\" -inside_of_layer ${lyr}fillArea2 \
      -pattern \"${lyr}small__Rect\" -tag \"${lyr}small__Rect\" \
   "
   ## Swap horizontal and vertical parameters as needed
   if {$baseLyr == "M2" || $baseLyr == "M4" || 
       $baseLyr == "M6" || $baseLyr == "MT"} {
      puts "
         -step FSS_XSTEP FSS_YSTEP \
         -offset FSS_XOFFSET FSS_YOFFSET \
      "
   } else {
      puts "
         -step FSS_YSTEP FSS_XSTEP \
         -offset FSS_YOFFSET FSS_XOFFSET \
      "
   }
   puts "
         -repeat 1 \
         -fill_space FSS_SPSELF \
         -space FSS_SPEX ${lyr}_EXCLUDE \
         -space FSS_SPDC ${lyr}_DC \
         -space FSS_SP ${lyr} \
   "
   ## Necessary for instance fill with gray color M1
   if {$baseLyr == "M1"} {
      puts "            -space 0.001 PolyALLfiMarker \\"
   }

   if {$lyr == "PolyALL" || $lyr == "MTall"} {
      puts "
         ;
      dfm_fill \"${lyr}fillSpec\" -select \"${lyr}small__Rect\" \
         ${lyr}fillAllTypes ;
      "
   } else {
      puts "
      -pattern \"${lyr}medium_Rect\" -tag \"${lyr}medium_Rect\" \
      "
      ## Swap horizontal and vertical parameters as needed
      if {$baseLyr == "M2" || $baseLyr == "M4" || 
          $baseLyr == "M6" || $baseLyr == "MT"} {
         puts "
         -step FSS_XSTEP FSS_YSTEP \
      "
      } else {
         puts "
         -step FSS_YSTEP FSS_XSTEP \
         "
      }
      puts "
         -repeat 1 \
         -fill_space FSM_SPSELF \
         -space FSM_SPEX ${lyr}_EXCLUDE \
         -space FSM_SPDC ${lyr}_DC \
      "
      ## Necessary for instance fill with gray color M1
      if {$baseLyr == "M1"} {
         puts "            -space 0.001 PolyALLfiMarker \\"
      }
      
      puts "
         -space FSM_SP ${lyr} \
         ;
   
      dfm_fill \"${lyr}fillSpec\" -select \"${lyr}small__Rect\" ${lyr}fillType1 ;
      dfm_fill \"${lyr}fillSpec\" -select \"${lyr}medium_Rect\" ${lyr}fillType2 ;
      cat ${lyr}fillType1 ${lyr}fillType2 ${lyr}fillAllTypes ;
      "
   }

   ## Output Rules
   if {[regexp color1 $lyr]} {
      puts "
      //rule gen-${baseLyr}-FILL-1-fill {
      //   copy ${lyr}fillAllTypes ; 
      //} 
      "
   } elseif {[regexp color2 $lyr]} {
      puts "
      //rule gen-${baseLyr}-FILL-2-fill {
      //   copy ${lyr}fillAllTypes ; 
      //} 
      "
   } elseif {$baseLyr == "Poly" || $baseLyr == "Active"} {
      puts "
      //rule gen-${baseLyr}-FILL--dummy {
      //   copy ${lyr}fillAllTypes ; 
      //} 
      "
   } else {
      puts "
      //rule gen-${baseLyr}-FILL--fill {
      //   copy ${lyr}fillAllTypes ; 
      //} 
      "
   }
}

## Main Flow
set useCritNet $::env(SELECT_CRITICAL_NET_FEATURE)
## Only External Instance Fill Enabled currently, no switch needed currently
#set useExtFillInst $::env(SELECT_EXTERNAL_INST_FILL)
set useInstFill $::env(SELECT_INST_FILL)


## Poly
## Since useInstFill is set, Active fill is also accomplished
puts "cat Poly_DRAWING Poly_DUMMY Poly_EDGE PolyALL ;"
## Use the fill instance marker as the exclude layer
#puts "empty_layer PolyALL_EXCLUDE ;"
puts "empty_layer PolyALL_DC ;"
GPDKrunFill Poly PolyALL N fillBoundary 0 $useInstFill
if {[info exists ::env(FILL_Poly)]} {
if {$::env(FILL_Poly) == "YES"} {
 puts "
 rule gen-Poly-FILL--dummy {
    copy PolyALLfillAllTypes ;
 }
 rule mrk-Poly-FILL--fillcell_p1 {
    copy PolyALLfiBoxPtype ;
 }
 rule mrk-Poly-FILL--fillcell_n1 {
    copy PolyALLfiBoxNtype ;
 }
 "
 if {![info exists ::UseInDesignFlow]} {
  if {[info exists ::OUTPUT_LAYOUT_OASIS]} {
   puts "
   output -drc gen-Poly-FILL--dummy   -oasis 20 10  output.oas -maximum all ;
   output -drc mrk-Poly-FILL--fillcell_n1 -oasis 154 120 output.oas -aref fillcell_n1 0.515 0.256 1 -maximum all ;
   output -drc mrk-Poly-FILL--fillcell_p1 -oasis 154 121 output.oas -aref fillcell_p1 0.515 0.256 1 -maximum all ;
   "
  } else {
   puts "
   output -drc gen-Poly-FILL--dummy   -gdsii 20 10  output.gds -maximum all ;
   output -drc mrk-Poly-FILL--fillcell_n1 -gdsii 154 120 output.gds -aref fillcell_n1 0.515 0.256 1 -maximum all ;
   output -drc mrk-Poly-FILL--fillcell_p1 -gdsii 154 121 output.gds -aref fillcell_p1 0.515 0.256 1 -maximum all ;
   "
  }
 }
}
}

## M1
puts "copy M1_EXCLUDE M1color1_EXCLUDE ;"
puts "copy M1color2 M1color1_DC ;"
GPDKrunFill M1 M1color1 Y fillBoundary $useCritNet 0 

puts "copy M1_EXCLUDE M1color2_EXCLUDE ;"
