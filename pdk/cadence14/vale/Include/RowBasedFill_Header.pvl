// PVS RULE DECK FOR VALE FRAMEWORK COMPONENT MODULE
// AGPDK 10nm
//

df2key enableColoring yes ;

layout_path "CELLNAME.gds" gdsii;
layout_primary "CELLNAME";
results_db -drc "CELLNAME.db" -ascii;

input_scale 2000;
grid 1;
unit -length u;
text_depth -primary;

layout_format gdsii
max_results -drc -all

flag -nonsimple yes;

layer_def BuriedNWell 1100 
 layer_map 3 -datatype 0 1100

layer_def NWelli 1001 
 layer_map 5 -datatype 0 1001

