// Technology specific custom layer definitions
layer_def prBoundaryObj 8319;
layer_map 1000 -datatype 0 8319;
layer_def Poly_Track 8350;
layer_map 20 -datatype 6 8350;

// Multiple layers with multiple grids means that each must me classified
// and combinations must be recognized.
//
// Poly style - pitch - width - space
// 1 -  86n - 18n - 68n
// 2 -  90n - 18n - 72n 
// 3 -  90n - 20n - 70n 
// 4 -  94n - 18n - 76n 
// 5 -  94n - 20n - 74n 
// 6 -  94n - 24n - 70n
// 7 - 102n - 18n - 84n
// 8 - 102n - 20n - 82n
// 9 - 102n - 24n - 78n
//10 - 102n - 28n - 74n
//11 - 104n - 18n - 86n
//12 - 104n - 20n - 84n
//13 - 104n - 24n - 80n
//14 - 104n - 28n - 76n
//15 - 104n - 30n - 74n

variable POLY_W_1 0.018
variable POLY_S_1 0.068
variable POLY_P_1 0.086
variable HALF_POLY_W_1 0.009
variable HALF_POLY_S_1 0.034
variable HALF_POLY_P_1 0.043

variable POLY_W_15 0.030
variable POLY_S_15 0.074
variable POLY_P_15 0.104
variable HALF_POLY_W_15 0.015
variable HALF_POLY_S_15 0.037
variable HALF_POLY_P_15 0.052

// Local interconnect width - space
// 30n - all spaces with poly pitch but given an ID according 
// to the row style 

// Row heights
// 1 - 528n

// A max distance to extend the diffusion as a full row in a boundary
variable MAX 3.0 ;

// Row pitch, double pitch
variable ROW_P_1 0.528

variable ROW_2P_1 1.056

// Row 2x pitch minus value for odd/even row classification
variable ROW_2PMV_1 0.956

// Generate a 2nm row joint
variable ROW_ID_HEIGHT_1 0.526

// Row Extension Past Diffusion 
// ROW_EXT_DIFF_1A = (ROW_ID_HEIGHT_1 - DIFF_WIDTH_1A)/ 2
variable ROW_EXT_DIFF_1A 0.160

// Orientation variable
variable ORIENT_90 90 ;

// Local interconnect/contact width and space 1
variable LI_W_1 0.030 ;
variable LI_S_1 0.056 ;
variable HALF_LI_W_1 0.015 ;
variable HALF_LI_S_1 0.028 ;

// Local interconnect/contact width and space 2
variable LI_W_2 0.030
variable LI_S_2 0.074
variable HALF_LI_W_2 0.015
variable HALF_LI_S_2 0.037

// Related to fin width: 1A is 5 fin 
variable DIFF_WIDTH_1A 0.206
variable DIFF_WIDTH_1B 0.302
variable DIFF_WIDTH_1C 0.398
variable DIFF_WIDTH_1D 0.494

// Local interconnect/contact layer extension past diffusion
// A is the dimension away from an inverter center, B is towards the center
variable LI_EXT_DIFF_1A 0.020
variable LI_EXT_DIFF_1B 0.020
variable LI_EXT_DIFF_15A 0.020
variable LI_EXT_DIFF_15B 0.020
variable LI_EXT_DIFF_2C 0.0
variable LI_EXT_DIFF_2D 0.0
variable POLY_EXT_DIFF_1A 0.048
variable POLY_EXT_DIFF_1B 0.048
variable POLY_EXT_DIFF_15A 0.048
variable POLY_EXT_DIFF_15B 0.048
variable LI_EXT_DIFF_3A 0.0
variable LI_EXT_DIFF_3B 0.0
variable LI_EXT_DIFF_4A 0.0

// Diffusion Spacing to odd/even rows for style 1
variable DIFF_SP_O3 0.0
variable DIFF_SP_E3 0.0
// Diffusion Spacing to odd/even rows for style 2
variable DIFF_SP_O4 0.0
variable DIFF_SP_E4 0.0

variable IMPL_CUSTOM_3VA 0.0
variable IMPL_CUSTOM_3VB 0.0

variable IMPL_CUSTOM_4A 0.0
variable IMPL_CUSTOM_4B 0.0
variable IMPL_CUSTOM_4D 0.0
variable IMPL_CUSTOM_4E 0.0

// Parameters to generate Poly Cut
variable POLY_CUT_CUSTOM_1  0.017
variable POLY_CUT_CUSTOM_2A 0.0
variable POLY_CUT_CUSTOM_2B 0.0
variable POLY_CUT_CUSTOM_4A 0.0
variable POLY_CUT_CUSTOM_4B 0.0
variable POLY_CUT_CUSTOM_4C 0.0
variable POLY_CUT_CUSTOM_4D 0.0

// Parameters for Active Fill for Dummy and Tap Rows
variable ACTIVE_X4W_15 0.342
variable ACTIVE_X4S_15 0.074
variable HALF_ACTIVE_X4W_15 0.171
variable HALF_ACTIVE_X4S_15 0.037

// mapped from object map
layer_def BoundaryArea 8320;
layer_map 1000 -datatype 1 8320;

// Rename layers to generic
and Poly_DRAWING  BoundaryArea Poly
or Poly_DUMMY Poly_EDGE PolyMulti
and PolyMulti     BoundaryArea PolyDummy
copy Poly_Track   PolyRegion
and LiAct         BoundaryArea LiCont
and Active        BoundaryArea Diff
and ThickOx       BoundaryArea DiffMarkerA1
and NWelli        BoundaryArea NWell
copy CutPolyi     CutPoly
or Plvt Psvt      tmpImplP
or Phvt tmpImplP  ImplP
or Plvt Nlvt      ImplLvt
or Psvt Nsvt      ImplSvt
or Phvt Nhvt      ImplHvt

