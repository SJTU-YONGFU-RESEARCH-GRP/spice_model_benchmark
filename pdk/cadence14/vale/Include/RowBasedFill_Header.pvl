 layer_map 35 -datatype eq 4 1245;

layer_def CutM3  1251; 
 layer_map 39 -datatype eq 0 1251;

layer_def CutM3_MASK1_UNLOCK 1252;
 layer_map 39 -datatype eq 1 1252;

