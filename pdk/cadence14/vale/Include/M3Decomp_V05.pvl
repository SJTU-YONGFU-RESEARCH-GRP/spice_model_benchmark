df2key enableColoring yes ;

// Set design type
#ifndef GPDK_DECOMP_CONFIG
 #IFDEF $GPDK_INSTALL_DIR
  #DEFINE SELECT_DECOMP
  include $GPDK_INSTALL_DIR/pvs/pvlDRC.rul
 #ELSE
  #IFDEF $CDS_MVS_IMF_CM
   #DEFINE SELECT_DECOMP
   include $CDS_MVS_IMF_CM/Include/pvlDRC.rul
  #ELSE
   #UNDEFINE SELECT_DECOMP
   pvl_message "No GPDK install or VALE framework setup available";
  #ENDIF
 #ENDIF
#endif

#IFDEF SELECT_DECOMP
select_check DECOMP_OUTPUT ;
#ELSE
unselect_check DECOMP_OUTPUT ;
#ENDIF

PVS_READ_TCL_BLOCK

proc VALEfmwkMetalDecomp {lyr showLinks} {
   puts "
   cat ${lyr}_MASK1 ${lyr}_MASK2 ${lyr}_colored ;
   not ${lyr} ${lyr}_colored ${lyr}node ;

   //copy ${lyr} ${lyr}node ;
   dfm_copy ${lyr}_link_sp21_${lyr} ${lyr}_link_sp22_${lyr} \
      ${lyr}_link_sp23_${lyr} ${lyr}_link_sp24_${lyr} \
      ${lyr}_link_sp41_${lyr} -outputLayer ${lyr}links ;
   balancecolor ${lyr}node ${lyr}links -min_s 0.048 -wire -keep_seed_color \
      -seed0 ${lyr}_MASK1 -seed1 ${lyr}_MASK2 \
      -color0 ${lyr}color1 -color1 ${lyr}color2 ;
   
   rule gen-${lyr}-DECOMP-1-drawing {
      copy ${lyr}color1 ;
   }
   rule gen-${lyr}-DECOMP-2-drawing {
      copy ${lyr}color2 ;
   }
   "
   if {$showLinks == "yes"} {
      puts "
      rule mrk-${lyr}-DECOMP--link_SP2_1 {
         copy ${lyr}_link_sp21_${lyr} ;
      }
      rule mrk-${lyr}-DECOMP--link_SP2_2 {
         copy ${lyr}_link_sp22_${lyr} ;
      }
      rule mrk-${lyr}-DECOMP--link_SP2_3 {
         copy ${lyr}_link_sp23_${lyr} ;
      }
      rule mrk-${lyr}-DECOMP--link_SP2_4 {
         copy ${lyr}_link_sp24_${lyr} ;
      }
      rule mrk-${lyr}-DECOMP--link_SP4_1 {
         copy ${lyr}_link_sp41_${lyr} ;
      }
      "
   }
}

VALEfmwkMetalDecomp M3 yes

PVS_END_TCL_BLOCK

group_rules DECOMP_OUTPUT 
   mrk-M3-DECOMP--link_SP2_1
   mrk-M3-DECOMP--link_SP2_2
   mrk-M3-DECOMP--link_SP2_3
   mrk-M3-DECOMP--link_SP2_4
   mrk-M3-DECOMP--link_SP4_1
   gen-M3-DECOMP-1-drawing
   gen-M3-DECOMP-2-drawing
   ; 
