;; Example SKILL to Create Metal Width Spacing Patterns for the Advanced
;; Node GPDK 

let((cv)
   cv = geGetWindowCellView()
   unless(cv
      printf("VALE ERROR: Unable to find an active layout window to load WSPs ")
      printf("into. Please locate or open a layout window and try again.\n")
   )

   when(cv

      ;; Define Width Spacing Pattern Templates
      ;;;;;;;;;;;
      ;;;;; M1
      ;;;;;;;;;;;

      wspCreateWSP(cv "M1_w48_s48_template"
         ?shiftColor t
         ?allowedRepeatMode "any"
         ?defaultRepeatMode "stepped"
         0.048 0.096 "color:1"
      )

      wspCreateWSP(cv "M1_w48_s96_template"
         ?shiftColor t
         ?allowedRepeatMode "any"
         ?defaultRepeatMode "stepped"
         0.048 0.144 "color:1"
      )
     
      wspCreateWSP(cv "M1_w48_s144_template"
         ?shiftColor t
         ?allowedRepeatMode "any"
         ?defaultRepeatMode "stepped"
         0.048 0.192 "color:1"
      )
     
      wspCreateWSP(cv "M1_w48_s192_template"
         ?shiftColor t
         ?allowedRepeatMode "any"
         ?defaultRepeatMode "stepped"
         0.048 0.240 "color:1"
      )
    
      wspCreateWSP(cv "M1_w36_w48_w52_template"
         ?allowedRepeatMode "any"
         ?defaultRepeatMode "stepped"
         0.036 0.072 "color:2"
         0.048 0.096 "color:1"
         0.052 0.096 "color:2"
         0.048 0.072 "color:1"
      )

      ;;;;;;;;;;;
      ;;;;; M2
      ;;;;;;;;;;;

