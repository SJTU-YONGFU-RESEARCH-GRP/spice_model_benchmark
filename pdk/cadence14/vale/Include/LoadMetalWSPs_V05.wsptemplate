      ;; Define Width Spacing Pattern Regions
      wspCreateWSSPDef(cv "M1_p96_w48_s48_region" "M1" "horizontal" 0.096
         ?defaultActive "M1_w48_s48_template") 
      wspCreateWSSPDef(cv "M1_p144_w48_s96_region" "M1" "horizontal" 0.144
         ?defaultActive "M1_w48_s96_template") 
      wspCreateWSSPDef(cv "M1_p192_w48_s144_region" "M1" "horizontal" 0.192
         ?defaultActive "M1_w48_s144_template")
      wspCreateWSSPDef(cv "M1_p240_w48_s192_region" "M1" "horizontal" 0.240
         ?defaultActive "M1_w48_s192_template")
      wspCreateWSSPDef(cv "M1_p336_w36w48w52_region" "M1" "horizontal" 0.336
         ?defaultActive "M1_w36_w48_w52_template")

      wspCreateWSSPDef(cv "M2_p086_region" "M2" "vertical" 0.086
         ?defaultActive "M2_w32_s54_template" ?allowedPatterns list("M2_w32_s54_template" "M2_w36_s50_template" "M2_w48_s38_template") )
      wspCreateWSSPDef(cv "M2_p090_region" "M2" "vertical" 0.090
         ?defaultActive "M2_w32_s58_template" ?allowedPatterns list("M2_w32_s58_template" "M2_w36_s54_template" "M2_w48_s42_template") )
      wspCreateWSSPDef(cv "M2_p094_region" "M2" "vertical" 0.094
         ?defaultActive "M2_w32_s62_template" ?allowedPatterns list("M2_w32_s62_template" "M2_w36_s58_template" "M2_w48_s46_template") )
      wspCreateWSSPDef(cv "M2_p102_region" "M2" "vertical" 0.102
         ?defaultActive "M2_w32_s70_template" ?allowedPatterns list("M2_w32_s70_template" "M2_w36_s64_template" "M2_w48_s54_template") )
      wspCreateWSSPDef(cv "M2_p104_region" "M2" "vertical" 0.104
