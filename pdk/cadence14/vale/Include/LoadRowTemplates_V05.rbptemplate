;; Example SKILL to Create Custom Row Templates for the Adv Node GPDK
;; Technology with 48nm fin pitch, 14nm fin width, 34nm fin space
;; Revision History:
;;    190228 JF Created 528 row height for 6 fin devices
;;    191203 JF Created 384 row height for 3 fin devices
;;    191203 JF Created 624 row height for 8 fin devices
 

let((cv cfg allTypes rowspecs pTypes nTypes)

   cv = geGetWindowCellView()
   unless(cv
      printf("VALE ERROR: Unable to find an active layout window. Please ")
      printf("locate or open a layout window and try to create rows again.\n")
   )

   when(cv
      nTypes = getShellEnvVar("RBP_N_COMPONENTS")
      pTypes = getShellEnvVar("RBP_P_COMPONENTS")


      if(nTypes then
         nTypes = parseString(nTypes)
         if(pTypes then
            pTypes = parseString(pTypes)
            allTypes = append(nTypes pTypes) 
         else
            allTypes = nTypes
         )
      else
         if(pTypes then
            pTypes = parseString(pTypes)
            allTypes = pTypes 
         else
            allTypes = VALEgetComponentTypes(cv)
            unless(allTypes
               allTypes = list("device")
            )
         )
      )
                
      ;;;;;;;;;;;;;;;;;;;;;;;;
      ;; Create nppn384fin3 ;;
      ;;;;;;;;;;;;;;;;;;;;;;;;
      rowspecs = list(
         list(nil 'name "n384a"
                  'offset 0.0
                  'orient "R0"
                  'height 0.384
                  'compAttrs list(
                     list(nil 'allowedTypes nTypes
                              'refOnArea "centerAlignment"
                              'refOnComp "centerAlignment"
                              'orients list("R0")
                     )
                  )
         )
         list(nil 'name "p384a"
                  'offset 0.384
                  'orient "R0"
                  'height 0.384
                  'compAttrs list(
                     list(nil 'allowedTypes pTypes
                              'refOnArea "centerAlignment"
                              'refOnComp "centerAlignment"
                              'orients list("R0")
                              'offset -0.048
                     )
                  )
         )
         list(nil 'name "p384b"
                  'offset 1.152
                  'orient "MX"
                  'height 0.384
                  'compAttrs list(
                     list(nil 'allowedTypes pTypes
                              'refOnArea "centerAlignment"
                              'refOnComp "centerAlignment"
                              'orients list("R0")
                     )
                  )
         )
         list(nil 'name "n384b"
                  'offset 1.536
                  'orient "MX"
                  'height 0.384
                  'compAttrs list(
                     list(nil 'allowedTypes nTypes
                              'refOnArea "centerAlignment"
                              'refOnComp "centerAlignment"
                              'orients list("R0")
                              'offset -0.048
                     )
                  )
         )
      )
      dbCreateRowRegionSpec(cv "nppn384fin3" 1.536 rowspecs list("" "GFG")
         list(0.0 0.024))

      ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
      ;; Create instance row: inst384 ;;
      ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
      rowspecs = list(
         list(nil 'name "row384"
                  'offset 0.0
                  'orient "R0"
                  'height 0.384
                  'compAttrs list(
                     list(nil
                        'compFilters list(list("*" "*" "*"))
                        'refOnArea "bottomAlignment"
                        'refOnComp "bottomAlignment"
                        'orients list("R0")
                     )
                  )
         )
      )
      dbCreateRowRegionSpec(cv "inst384" 0.384 rowspecs list("" "GFG")
         list(0.0 0.024))

      ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
      ;; Create RowType1: nppn528fin5 ;;
      ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
      rowspecs = list(
         list(nil 'name "n528a"
                  'offset 0.0
                  'orient "R0"
                  'height 0.528
                  'compAttrs list(
                     list(nil 'allowedTypes nTypes
                              'refOnArea "centerAlignment"
                              'refOnComp "centerAlignment"
                              'orients list("R0")
                     )
                  )
         )
         list(nil 'name "p528a"
                  'offset 0.528
                  'orient "R0"
                  'height 0.528
                  'compAttrs list(
                     list(nil 'allowedTypes pTypes
                              'refOnArea "centerAlignment"
                              'refOnComp "centerAlignment"
                              'orients list("R0")
                     )
                  )
         )
         list(nil 'name "p528b"
                  'offset 1.584
                  'orient "MX"
                  'height 0.528
                  'compAttrs list(
                     list(nil 'allowedTypes pTypes
                              'refOnArea "centerAlignment"
                              'refOnComp "centerAlignment"
                              'orients list("R0")
                     )
                  )
         )
         list(nil 'name "n528b"
                  'offset 2.112
                  'orient "MX"
                  'height 0.528
                  'compAttrs list(
                     list(nil 'allowedTypes nTypes
                              'refOnArea "centerAlignment"
                              'refOnComp "centerAlignment"
                              'orients list("R0")
                     )
                  )
         )
      )
      dbCreateRowRegionSpec(cv "nppn528fin5" 2.112 rowspecs list("" "GFG")
         list(0.0 0.024))

      ;;;;;;;;;;;;;;;;;;;;;;;;
      ;; Create nppn528fin6 ;;
      ;;;;;;;;;;;;;;;;;;;;;;;;
      rowspecs = list(
         list(nil 'name "n528a"
                  'offset 0.0
                  'orient "R0"
                  'height 0.528
                  'compAttrs list(
                     list(nil 'allowedTypes nTypes
                              'refOnArea "centerAlignment"
                              'refOnComp "centerAlignment"
                              'orients list("R0")
                              'offset 0.048
                     )
                  )
         )
         list(nil 'name "p528a"
                  'offset 0.528
                  'orient "R0"
                  'height 0.528
                  'compAttrs list(
                     list(nil 'allowedTypes pTypes
                              'refOnArea "centerAlignment"
                              'refOnComp "centerAlignment"
                              'orients list("R0")
                     )
                  )
         )
         list(nil 'name "p528b"
                  'offset 1.584
                  'orient "MX"
                  'height 0.528
                  'compAttrs list(
                     list(nil 'allowedTypes pTypes
                              'refOnArea "centerAlignment"
                              'refOnComp "centerAlignment"
                              'orients list("R0")
                              'offset 0.048
                     )
                  )
         )
         list(nil 'name "n528b"
                  'offset 2.112
                  'orient "MX"
                  'height 0.528
                  'compAttrs list(
                     list(nil 'allowedTypes nTypes
                              'refOnArea "centerAlignment"
                              'refOnComp "centerAlignment"
                              'orients list("R0")
                     )
                  )
         )
      )
      dbCreateRowRegionSpec(cv "nppn528fin6" 2.112 rowspecs list("" "GFG")
         list(0.0 0.024))

      ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
      ;; Create instance row: inst528 ;;
      ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
      rowspecs = list(
         list(nil 'name "row528"
                  'offset 0.0
                  'orient "R0"
                  'height 0.528
                  'compAttrs list(
                     list(nil
                        'compFilters list(list("*" "*" "*"))
                        'refOnArea "bottomAlignment"
                        'refOnComp "bottomAlignment"
                        'orients list("R0")
                     )
                  )
         )
      )
      dbCreateRowRegionSpec(cv "inst528" 0.528 rowspecs list("" "GFG")
         list(0.0 0.024))

      ;;;;;;;;;;;;;;;;;;;;;;;;
      ;; Create nppn624fin8 ;;
      ;;;;;;;;;;;;;;;;;;;;;;;;
      rowspecs = list(
         list(nil 'name "n624a"
                  'offset 0.0
                  'orient "R0"
                  'height 0.624
                  'compAttrs list(
                     list(nil 'allowedTypes nTypes
                              'refOnArea "centerAlignment"
                              'refOnComp "centerAlignment"
                              'orients list("R0")
                              'offset 0.048
                     )
                  )
         )
         list(nil 'name "p624a"
                  'offset 0.624
                  'orient "R0"
                  'height 0.624
                  'compAttrs list(
                     list(nil 'allowedTypes pTypes
                              'refOnArea "centerAlignment"
                              'refOnComp "centerAlignment"
                              'orients list("R0")
                     )
                  )
         )
         list(nil 'name "p624b"
                  'offset 1.872
                  'orient "MX"
                  'height 0.624
                  'compAttrs list(
                     list(nil 'allowedTypes pTypes
                              'refOnArea "centerAlignment"
                              'refOnComp "centerAlignment"
                              'orients list("R0")
                              'offset 0.048
                     )
                  )
         )
         list(nil 'name "n624b"
                  'offset 2.496
                  'orient "MX"
                  'height 0.624
                  'compAttrs list(
                     list(nil 'allowedTypes nTypes
                              'refOnArea "centerAlignment"
                              'refOnComp "centerAlignment"
                              'orients list("R0")
                     )
                  )
         )
      )
      dbCreateRowRegionSpec(cv "nppn624fin8" 2.496 rowspecs list("" "GFG")
         list(0.0 0.024))

      ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
      ;; Create instance row: inst624 ;;
      ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
      rowspecs = list(
         list(nil 'name "row624"
                  'offset 0.0
                  'orient "R0"
                  'height 0.624
                  'compAttrs list(
                     list(nil
                        'compFilters list(list("*" "*" "*"))
                        'refOnArea "bottomAlignment"
                        'refOnComp "bottomAlignment"
                        'orients list("R0")
                     )
                  )
         )
      )
      dbCreateRowRegionSpec(cv "inst624" 0.624 rowspecs list("" "GFG")
         list(0.0 0.024))
   )
)

