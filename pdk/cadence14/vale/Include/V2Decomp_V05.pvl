df2key enableColoring yes ;

// Set design type
#ifndef GPDK_DECOMP_CONFIG
 #IFDEF $GPDK_INSTALL_DIR
  #DEFINE SELECT_DECOMP
  include $GPDK_INSTALL_DIR/pvs/pvlDRC.rul
 #ELSE
  #IFDEF $CDS_MVS_IMF_CM
   #DEFINE SELECT_DECOMP
   include $CDS_MVS_IMF_CM/Include/pvlDRC.rul
  #ELSE
   #UNDEFINE SELECT_DECOMP
   pvl_message "No GPDK install or VALE framework setup available";
  #ENDIF
 #ENDIF
#endif

#IFDEF SELECT_DECOMP
select_check DECOMP_OUTPUT ;
#ELSE
unselect_check DECOMP_OUTPUT ;
#ENDIF

PVS_READ_TCL_BLOCK

proc VALEfmwkViaDecomp {lyr showLinks} {
   puts "
   rule gen-${lyr}-DECOMP-1-drawing {
      copy ${lyr}_C0 ;
   }
   rule gen-${lyr}-DECOMP-2-drawing {
      copy ${lyr}_C1 ;
   }
   rule gen-${lyr}-DECOMP-3-drawing {
      copy ${lyr}_C2 ;
   }
   "
   if {$showLinks == "yes"} {
      puts "
      rule mrk-${lyr}-DECOMP--link_SP2 {
         copy ${lyr}_LINK_SP3 ;
      }

      "
   }
}

VALEfmwkViaDecomp V2 yes

PVS_END_TCL_BLOCK

group_rules DECOMP_OUTPUT 
   mrk-V2-DECOMP--link_SP2
   gen-V2-DECOMP-1-drawing
   gen-V2-DECOMP-2-drawing
   gen-V2-DECOMP-3-drawing
   ;
