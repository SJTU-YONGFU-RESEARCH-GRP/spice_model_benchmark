<deck version_str="1.0">
 <properties lpa_xml_version="2.0"/>

 <target_sels_map map_name="E2">
  <remap from_sel="M1MASK1" to_sel="M1MASK2"/>
  <remap from_sel="M1TRIM1" to_sel="M1TRIM2"/>
  <remap from_sel="M2MASK1" to_sel="M2MASK2"/>
  <remap from_sel="M2TRIM1" to_sel="M2TRIM2"/>
