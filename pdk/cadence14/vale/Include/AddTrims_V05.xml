 <rule>
  <rulename>M1lineEndIso</rulename>
  <report custom_orients="R90 R270" />
  <target_sels_map_name>E2</target_sels_map_name>
  <pattern_def type="squish"
    signature="L2
               0 0 /
               1 0 /
               0 0 "
    x_deltas="10 150"
    y_deltas="32 32-136 32" >
   <pattern sel="M1MASK1" />
   <pattern sel="M1TRIM1" />
   <overlay_scanline_range range_str="x1-10 y1-10 x1+10 y2+10" output_layer="MARKER" />
   <properties primary_layer="M1MASK1" hotspot_type="WIDTH" hotspot_level="1" >
    <repair>
     <hint>
      <group>
       <overlay_scanline_range range_str="x0 x1 y1 y2" output_layer="PATTERNREF_M1" action="ADDRECT"/>
       <overlay_scanline_range range_str="x0 x1 y1 y2" output_layer="PROPERTY_LOCKCOLOR" action="ADDRECT"/>
       <overlay_scanline_range range_str="x0 x1 y1 y2" output_layer="NOPATTERNREF_M1/drawing" action="ADDRECT"/>
       <overlay_scanline_range range_str="x0 x1 y1 y2" output_layer="PROPERTY_imfGenerated:string:AddTrims" action="ADDRECT"/>
       <overlay_scanline_range range_str="x1 x1+40 y1-32 y2+32" output_layer="CutM1/drawing-addrect" action="ADDRECT"/>
      </group>
     </hint>
    </repair>
   </properties>
  </pattern_def>
 </rule>

