
rule gen-Poly-RBF--drawing {
   copy polyGen1
}
rule gen-Poly-RBF--edge {
   copy polyGen2
}
rule gen-Poly-RBF--dummy {
   copy polyGen3
}

rule gen-Active-RBF--dummy {
   select -interact actFill_r1p15 dummyRows
}

rule gen-Active-RBF--drawing {
   select -interact actFill_r1p15 tapRows
}

rule gen-LiAct-RBF--drawing {
   copy liFillFinal1 ;
}

rule gen-CutPoly-RBF--drawing {
   copy polyCutFinal1
}

// Implant or Boundary Layers
rule gen-Nlvt-RBF--drawing {
   select -interact nImplant1 Nlvt
   select -interact nImplant1 lvtImplRows1
}
rule gen-Plvt-RBF--drawing {
   select -interact pImplant1 Plvt 
   select -interact pImplant1 lvtImplRows1
}
rule gen-Nsvt-RBF--drawing {
   select -interact nImplant1 Nsvt
   select -interact nImplant1 svtImplRows1
}
rule gen-Psvt-RBF--drawing {
   select -interact pImplant1 Psvt
   select -interact pImplant1 svtImplRows1
}
rule gen-Nhvt-RBF--drawing {
   select -interact nImplant1 Nhvt
   select -interact nImplant1 hvtImplRows1
}
rule gen-Phvt-RBF--drawing {
   select -interact pImplant1 Phvt
   select -interact pImplant1 hvtImplRows1
}

rule gen-NWell-RBF--drawing {
   copy genNWell
}

// Other boundary layers
rule gen-ThickOx-RBF--drawing {
   select -interact PolyRegion polyStyle15 tmpThickOx15
   select -interact tmpThickOx15 DiffMarkerA1
}
 
