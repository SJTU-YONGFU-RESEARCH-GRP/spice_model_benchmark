### cds_ff_mpt GPDK process ictfile
process "em" {
   em_tref 110
   em_output_wlt drawn
   em_variables w l
   em_conductor_unit mA/um
   em_via_area_unit mA
   em_via_unit mA
   em_lifetime_units hours
   em_segment_length total
}

conductor "Poly" {
   em_model {
      em_jmax_dc_rms EQU 0.2 * ( 2.1 * sqrt( w ) ) + ( 1.95 * w )
      em_jmax_ac_rms EQU 0.2 * ( 2.1 * sqrt( w ) ) + ( 1.95 * w )
   }
}

conductor "LiPo" {
   em_model {
      em_jmax_dc_rms EQU 0.1 * ( 2.1 * sqrt( w ) ) + ( 1.95 * w )
      em_jmax_ac_rms EQU 0.1 * ( 2.1 * sqrt( w ) ) + ( 1.95 * w )
   }
}

conductor "LiAct" {
   em_model {
      em_jmax_dc_rms EQU 0.15 * ( 2.1 * sqrt( w ) ) + ( 1.95 * w )
      em_jmax_dc_rms EQU 0.15 * ( 2.1 * sqrt( w ) ) + ( 1.95 * w )
   }
}

conductor "M1" {		# 1X thickness
   em_model {
      em_jmax_dc_avg EQU 2.5 * 1.05 * ( w - 0.002)  jmax_factor 100 2.0 105 1.5 110 1.0 120 0.5 150 0.3  jmax_life 50000 2.0 100000 1.0 200000 0.5          L <= 5
      em_jmax_dc_avg EQU 1.0 * 1.05 * ( w - 0.002)  jmax_factor 100 2.0 105 1.5 110 1.0 120 0.5 150 0.3  jmax_life 50000 2.0 100000 1.0 200000 0.5  L >  5                      W <  0.064
      em_jmax_dc_avg EQU 2.0 * 1.05 * ( w - 0.002)  jmax_factor 100 2.0 105 1.5 110 1.0 120 0.5 150 0.3  jmax_life 50000 2.0 100000 1.0 200000 0.5  L >  5          W >= 0.064

      em_jmax_ac_avg EQU 2.5 * 1.05 * ( w - 0.002)  jmax_factor 100 2.0 105 1.5 110 1.0 120 0.5 150 0.3  jmax_life 50000 2.0 100000 1.0 200000 0.5          L <= 5
      em_jmax_ac_avg EQU 1.0 * 1.05 * ( w - 0.002)  jmax_factor 100 2.0 105 1.5 110 1.0 120 0.5 150 0.3  jmax_life 50000 2.0 100000 1.0 200000 0.5  L >  5                      W <  0.064
      em_jmax_ac_avg EQU 2.0 * 1.05 * ( w - 0.002)  jmax_factor 100 2.0 105 1.5 110 1.0 120 0.5 150 0.3  jmax_life 50000 2.0 100000 1.0 200000 0.5  L >  5          W >= 0.064
 
      em_jmax_dc_rms EQU 0.23 * ( 4.1 * sqrt( w ) ) + ( 3.8 * w )
      em_jmax_ac_rms EQU 0.23 * ( 4.1 * sqrt( w ) ) + ( 3.8 * w )

      em_jmax_dc_peak EQU  100.0 * (w - 0.002)
      em_jmax_ac_peak EQU  100.0 * (w - 0.002)
   }
}

