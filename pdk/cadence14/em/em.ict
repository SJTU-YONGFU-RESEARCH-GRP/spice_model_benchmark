      em_jmax_dc_peak EQU  800.0 * (w - 0.01)
      em_jmax_ac_peak EQU  800.0 * (w - 0.01)
   }
}

via "Poly_LiPo" {
   top_layer "LiPo"
   bottom_layer "Poly"
   em_model {
      em_vcwidth 0.03200
      em_jmax_dc_avg PWL 0.10 0.001024 0.2000 0.002560  jmax_factor 100 4.0 105 3.5 110 3.0 120 2.5 150 2.0           Lu <= 2
      em_jmax_dc_avg PWL 0.08 0.001024 0.1600 0.002560  jmax_factor 100 4.0 105 3.5 110 3.0 120 2.5 150 2.0  Lu >  2  Lu <= 5
      em_jmax_dc_avg PWL 0.10 0.001024                  jmax_factor 100 4.0 105 3.5 110 3.0 120 2.5 150 2.0  Lu >  2  Lu <= 5  Wu >= 0.064  single
      em_jmax_dc_avg PWL 0.06 0.001024                  jmax_factor 100 4.0 105 3.5 110 3.0 120 2.5 150 2.0  Lu >  5           Wu >= 0.064
