   space ndiff18 by 0.1

   rule foundry_pdiff18_minSpacing "pdiff18 minSpacing is 0.1"
   space pdiff18 by 0.1

   rule foundry_ngate11_minWidth "ngate11 minWidth is 0.045"
   widen ngate11 by 0.045

   rule foundry_pgate11_minWidth "pgate11 minWidth is 0.045"
