   MOSFET HVTPMOS11 hvtpmos POLY OXIDE NWELL scale 1
end

abutment_boundaries
end

design_rules
recommended 0

   rule foundry_NBURIED_minWidth "NBURIED minWidth is 0.8"
   widen NBURIED by 0.8

   rule foundry_NBURIED_minSpacing "NBURIED minSpacing is 2"
   space NBURIED by 2

   rule foundry_NWELL_minWidth "NWELL minWidth is 0.3"
   widen NWELL by 0.3

   rule foundry_NWELL_minSpacing "NWELL minSpacing is 0.6 minSameNetSpacing 0.3"
   space NWELL by 0.6 same_net 0.3

   rule foundry_PWDUMMY_minWidth "PWDUMMY minWidth is 0.3"
   widen PWDUMMY by 0.3

   rule foundry_PWDUMMY_minSpacing "PWDUMMY minSpacing is 0.3"
   space PWDUMMY by 0.3

   rule foundry_OXIDE_minWidth "OXIDE minWidth is 0.05 minDiagonalWidth 0.06"
   widen OXIDE by 0.05 diagonal 0.06

   rule foundry_OXIDE_minSpacing "ndiff to pdiff minSpacing is 0.1 minDiagonalSpacing 0.1"
   space ndiff from pdiff unless butted by 0.1

   rule foundry_ndiff_minSpacing "ndiff minSpacing is 0.08"
   space ndiff by 0.08

   rule foundry_pdiff_minSpacing "pdiff minSpacing is 0.08"
