objectives
   sd_cont growforce 6
	METAL1 shrinkforce 3
	OXIDE shrinkforce 4
	POLY shrinkforce 8
	ntap shrinkforce 3
	ptap shrinkforce 3
end

connections
 M1P to METAL1 electrical
 NIMP to PIMP overlap
end

alignment_locks
 M1P METAL1
end

