qtrek

 // NOR4X1 has next track Metal1 that should be connected to prevent wide spreading
 function M1notchfill = METAL1 +- 0.1 notchonly
 //create_elements * METAL1 M1notchfill

 function srcdrn = ( sd_ndiff | sd_pdiff ) & ~ POLY
 merge_vias nopolygons * CONT srcdrn 0.2
 function taps = ntap | ptap
 merge_vias nopolygons * CONT taps 0.2

 merge_elements * NWELL NWELL
 merge_elements * POLY POLY
 merge_elements * OXIDE OXIDE
 merge_elements * METAL1 METAL1
 merge_elements * METAL2 METAL2

 //merge_vias nopolygons * CONT ndiff 0.2
 //merge_vias nopolygons * CONT pdiff 0.2

 shrink * CONT CONT 0.01

 shrink *FILL* M1P M1P 0.02

