;;;;;;;;;;;;;;;;;             BEGIN LAYER DEFINITIONS          ;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(LayerDefinitions 
        (layer   ResWdum             0                    0    Drawing  Translate nil )
 	(layer   Oxide               1                    0    Drawing  Translate nil ) 
 	(layer   Nwell               2                    0    Drawing  Translate nil ) 
 	(layer   Poly                3                    0    Drawing  Translate nil ) 
 	(layer   Nimp                4                    0    Drawing  Translate nil ) 
 	(layer   Pimp                5                    0    Drawing  Translate nil ) 
 	(layer   Cont                6                    0    Drawing  Translate nil ) 
 	(layer   Metal1              7                    0    Drawing  Translate nil ) 
 	(layer   Via1                8                    0    Drawing  Translate nil ) 
 	(layer   Metal2              9                    0    Drawing  Translate nil ) 
 	(layer   Via2               10                    0    Drawing  Translate nil ) 
 	(layer   Metal3             11                    0    Drawing  Translate nil ) 
 	(layer   Capdum             12                    0    Drawing  Translate nil ) 
 	(layer   Resdum             13                    0    Drawing  Translate nil ) 
 	(layer   CapMetal           14                    0    Drawing  Translate nil ) 
 	(layer   BJTdum             15                    0    Drawing  Translate nil ) 
 	(layer   INDdummy           16                    0    Drawing  Translate nil ) 
 	(layer   IND2dummy          17                    0    Drawing  Translate nil ) 
 	(layer   Pwell              18                    0    Drawing  Translate nil ) 
 	(layer   Nburied            19                    0    Drawing  Translate nil ) 
 	(layer   NPNdummy           20                    0    Drawing  Translate nil ) 
 	(layer   PNPdummy           21                    0    Drawing  Translate nil ) 
        (layer   DIOdummy           22                    0    Drawing  Translate nil )
        (layer   SiProt             23                    0    Drawing  Translate nil )
        (layer   ThickOxide         24                    0    Drawing  Translate nil )
        (layer   Via3               30                    0    Drawing  Translate nil )
        (layer   Metal4             31                    0    Drawing  Translate nil )
        (layer   Via4               32                    0    Drawing  Translate nil )
        (layer   Metal5             33                    0    Drawing  Translate nil )
        (layer   Via5               34                    0    Drawing  Translate nil )
        (layer   Metal6             35                    0    Drawing  Translate nil )
        (layer   Bondpad            36                    0    Drawing  Translate nil )
 	(layer   WellBody           50                    0    Drawing NoTranslate nil ) 
        (layer   Psubiso            51                    0    Drawing  Translate nil )
        (layer   scaPort            66                    0    Drawing  Translate nil )
        (layer   scaNwell           67                    0    Drawing  Translate nil )
        (layer   scaNburied         68                    0    Drawing  Translate nil )
        (layer   scaSelect          69                    0    Drawing  Translate nil )
        (layer   IND3dummy          70                    0    Drawing  Translate nil )
        (layer   M1dummy            71                    0    Drawing  Translate nil )
        (layer   M2dummy            72                    0    Drawing  Translate nil )
        (layer   M3dummy            73                    0    Drawing  Translate nil )
        (layer   M4dummy            74                    0    Drawing  Translate nil )
        (layer   M5dummy            75                    0    Drawing  Translate nil )
        (layer   M6dummy            76                    0    Drawing  Translate nil )
 	(layer   PolyPin             3                    1        Pin NoTranslate  Poly ) 
 	(layer   PolyBlock         207                    0   Blockage NoTranslate  Poly ) 
 	(layer   Metal1Pin           7                    1        Pin NoTranslate Metal1 ) 
 	(layer   Metal1Block       208                    0   Blockage NoTranslate Metal1 ) 
 	(layer   Metal2Pin           9                    1        Pin NoTranslate Metal2 ) 
 	(layer   Metal2Block       209                    0   Blockage NoTranslate Metal2 ) 
 	(layer   Metal3Pin          11                    1        Pin NoTranslate Metal3 ) 
 	(layer   Metal3Block       210                    0   Blockage NoTranslate Metal3 ) 
 	(layer   Metal4Pin          32                    1        Pin NoTranslate Metal4 ) 
 	(layer   Metal4Block       211                    0   Blockage NoTranslate Metal4 )
 	(layer   Metal5Pin          33                    1        Pin NoTranslate Metal5 ) 
 	(layer   Metal5Block       212                    0   Blockage NoTranslate Metal5 ) 
 	(layer   Metal6Pin          35                    1        Pin NoTranslate Metal6 ) 
 	(layer   Metal6Block       213                    0   Blockage NoTranslate Metal6 ) 
 	(layer   PwellVariable      18                    3   Variable NoTranslate pwell ) 
 	(layer   NwellVariable       2                    3   Variable NoTranslate Nwell ) 
 	(layer   allGeoShare       100                    0   GeoShare NoTranslate   nil ) 
 	(layer   infoLayer         254                    0   Drawing    Translate   nil ) 
        (layer   text              230                    0   Drawing    Translate   nil )   
        (layer   prBoundary        235                    0   Drawing    Translate   nil )   
        (layer   drctest           231                    0   DRC        Translate   nil )
	(BackgroundLayer pwell) 
	
   (DerivedLayer polygate (+ Poly) (- Oxide))

) ;LayerDefinitions 


(CDSLayerMaps
  (Nwell ((Nwell drawing)))
  (Pwell ((Pwell drawing)))
  (Oxide ((Oxide drawing)))
  (ThickOxide ((ThickOxide drawing)))
  (Pimp ((Pimp drawing)))
  (Nimp ((Nimp drawing)))
  (Poly ((Poly drawing) (Poly boundary) ))
  (Resdum ((Resdum drawing)))
  (ResWdum ((ResWdum drawing)))
  (SiProt ((SiProt drawing)))
  (Capdum ((Capdum drawing)))
  (CapMetal ((CapMetal drawing)))
  (Nburied ((Nburied drawing)))
  (Cont ((Cont drawing)))
  (Via1 ((Via1 drawing)))
  (Metal1 ((Metal1 drawing) (Metal1 boundary)))
  (Via2 ((Via2 drawing)))
  (Metal2 ((Metal2 drawing) (Metal2 boundary)))
  (Metal3 ((Metal3 drawing) (Metal3 boundary)))
  (Via3 ((Via3 drawing)))
  (Metal4 ((Metal4 drawing) (Metal4 boundary)))
  (Metal5 ((Metal5 drawing) (Metal5 boundary)))
  (Via4 ((Via4 drawing)))
  (Metal6 ((Metal6 drawing) (Metal6 boundary)))
  (Via5 ((Via5 drawing)))
  (allGeoShare ((allGeoShare drawing) (allGeoShare GeoShare)))
  (WellBody ((WellBody drawing)))
  (prBoundary ((prBoundary drawing) (prBoundary boundary)))
  (text ((text drawing)))
) ; CDSLayerMaps

