(ModGen pmos (	
	(moduleEnclosure1 nil "Nwell {$left - 1000} {$bottom - 1000} {$right + 1000} {$top + 1000}")
));pmos

(ModGen pmos3 (
	(moduleEnclosure1 nil "Nwell {$left - 1000} {$bottom - 1000} {$right + 1000} {$top + 1000}")
));pmos3

(ModGen pmos3hv (
	(moduleEnclosure1 nil "Nwell {$left - 1000} {$bottom - 1000} {$right + 1000} {$top + 1000}")
   (deviceEnclosure1 nil "ThickOxide {$left - 250} {$bottom - 375} {$right + 250} {$top + 375}")	
   (spaceDeviceBody nil "500")
));pmos3hv

(ModGen pmoshv (
	(moduleEnclosure1 nil "Nwell {$left - 1000} {$bottom - 1000} {$right + 1000} {$top + 1000}")
   (deviceEnclosure1 nil "ThickOxide {$left - 250} {$bottom - 375} {$right + 250} {$top + 375}")	
   (spaceDeviceBody nil "500")
));pmoshv

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;          BEGIN PMRA INFORMATION        ;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(ModGen PMRA (
      	; No parameters.  For this technology, we have chosen to specify
      	; the parameters for each style, specifically.
))

(ModGen nplusres (

        ;;;;;;;;;;;;;;;;;;;;;;;
	; nplusres parameters ;
	;;;;;;;;;;;;;;;;;;;;;;;
        (stripeSpacing nil 300)
        (maxStripesPerGroup nil 3)
        (fullLengthStripesOnly nil 1)
        (routeOverDevice nil 0)
        (staggerStripes nil 0)
        (staggerDistance nil "not used")
        (silicideBlock nil "not used")

	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	; strip Enclosure parameters  ;
	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
        (stripeEnclosure1 nil  "Oxide {$left} {$activeBottom} {$right} {$activeTop}")
        (stripeEnclosure2 nil  "Resdum {$left-50} {$activeBottom-100} {$right+50} {$activeTop+100}")
        (stripeEnclosure3 nil  "PolyBlock {$left} {$activeBottom} {$right} {$activeTop}")
        (stripeEnclosure4 nil  "Metal1Block {$left} {$activeBottom} {$right} {$activeTop}")
        (stripeEnclosure5 nil  "Metal2Block {$left} {$activeBottom} {$right} {$activeTop}")
        (stripeEnclosure6 nil  "Metal3Block {$left} {$activeBottom} {$right} {$activeTop}")
    
        (bodyEnclosure1 nil "Nimp  {$left-200} {$bottom-200} {$right+200} {$top+200}")

