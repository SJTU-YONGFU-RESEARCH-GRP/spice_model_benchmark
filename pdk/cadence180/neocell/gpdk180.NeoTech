;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;         BEGIN GEOMETRIC LAYER RULES          ;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(LayerGeometricRules
	(Width      Nwell                  1000   nil "Nwell width = 1000nm") 
	(Spacing    Nwell      Nwell       1000   nil "Nwell spacing = 1000nm") 
	(Spacing    Nwell      Pwell          0   nil "Nwell to Pwell spacing = 00um") 
        (Spacing    Pwell      Pwell       1000   nil "Pwell to Pwell spacing = 1000nm")
        (Spacing    Pwell      Oxide        500   nil "Pwell to Oxide spacing = 500nm")
        (Spacing    Capdum     Capdum       100   nil "Capdum to Capdum spacing = 0.1um")
        (Spacing    Nburied    Nburied     1000   nil "Nburied to Nburied spacing = 1.0um")
	(Width      Oxide                   600   nil "Oxide width = 600nm") 
	(Spacing    Oxide      Oxide        300   nil "Oxide spacing = 300um") 
        (Spacing    Oxide      Poly         200   nil "Oxide to Poly spacing = 0.2um")
	(Width      Poly                    180   nil "Poly width = 180um") 
	(Spacing    Poly       Poly         300   nil "Poly spacing = 300nm") 
	(Width      Nimp                    400   nil "Nimp width = 400um")  
	(Spacing    Nimp       Nimp         400   nil "Nimp spacing = 400nm") 
	(Width      Pimp                    400   nil "Pimp width = 400nm") 
	(Spacing    Pimp       Pimp         400   nil "Pimp spacing = 400nm")
	(Width      Cont                    200   nil "Cont width = 200nm") 
	(Spacing    Cont       Cont         200   nil "Cont spacing = 200nm") 
	(Width      Metal1                  300   nil "Metal1 width = 300nm") 
	(Spacing    Metal1     Metal1       300   nil "Metal1 spacing = 300nm") 
	(Width      CapMetal                500   nil "CapMetal width = 500nm") 
	(Width      Via1                    200   nil "Via1 width = 200nm") 
	(Spacing    Via1       Via1         300   nil "Via1 spacing = 300um") 
	(Width      Metal2                  300   nil "Metal2 width = 300nm") 
	(Spacing    Metal2     Metal2       300   nil "Metal2 spacing = 300nm") 
	(Width      Via2                    200   nil "Via2 width = 200nm") 
	(Spacing    Via2       Via2         300   nil "Via2 spacing = 300nm") 
	(Width      Metal3                  300   nil "Metal3 width = 300nm") 
	(Spacing    Metal3     Metal3       300   nil "Metal3 spacing = 300nm") 
	(Width      Via3                    200   nil "Via3 width = 200nm") 
	(Spacing    Via3       Via3         300   nil "Via3 spacing = 300nm") 
	(Width      Metal4                  300   nil "Metal4 width = 300nm") 
	(Spacing    Metal4     Metal4       300   nil "Metal4 spacing = 300nm") 
	(Width      Via4                    200   nil "Via4 width = 200nm") 
	(Spacing    Via4       Via4         300   nil "Via4 spacing = 300nm") 
	(Width      Metal5                  300   nil "Metal5 width = 300nm") 
	(Spacing    Metal5     Metal5       300   nil "Metal5 spacing = 300nm") 
	(Width      Via5                    200   nil "Via5 width = 200nm") 
	(Spacing    Via5       Via5         300   nil "Via5 spacing = 300nm")
	(Width      Metal6                  300   nil "Metal6 width = 300nm") 
	(Spacing    Metal6     Metal6       300   nil "Metal6 spacing = 300nm")  
	;(Spacing    Metal3     Via2           0   nil "Metal3 to Via2 spacing = 0nm") 
        (Spacing    Oxide      Poly         200   nil "Oxide to Poly spacing = 200nm") 
        (Spacing    Oxide      polygate       0   nil "Oxide to Poly gate spacing = 0nm") 
        (Spacing    ThickOxide Oxide        250   nil "ThickOxide to Oxide spacing = 250nm")
        (Spacing    Pwell      Oxide        500   nil "Pwell to Oxide spacing = 500nm")
	;(Spacing    Poly       Cont         200   nil "Poly to Cont spacing = 200nm")
        (Spacing    Cont       Oxide        200   nil "Cont to Oxide spacing = 200nm") 
) ;LayerGeometricRules

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;          BEGIN ELECTRICAL LAYER RULES        ;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(LayerElectricalRules
	(sheetResistance    Poly       7.50     "comment field") 
	(sheetResistance    Oxide      300.00    "comment field") 
	(sheetResistance    Nimp       300.00    "comment field") 
	(sheetResistance    Metal1     0.10     "comment field") 


	;OverlapCap        Layer1     Layer2     Basic      Value    RuleID         
	(OverlapCap         Poly       Metal1     Basic      (0.0001) "PolyMetal1Cov")
	(OverlapCap         Poly       Metal2     Basic      (0.0001) "PolyMetal2Cov")
	(OverlapCap         Poly       Metal3     Basic      (0.0001) "PolyMetal3Cov")
	(OverlapCap         Metal1     Metal2     Basic      (0.0001) "Metal1Metal2Cov")
	(OverlapCap         Metal1     Metal3     Basic      (0.0001) "Metal1Metal3Cov")
	(OverlapCap         Metal2     Metal3     Basic      (0.0001) "Metal2Metal3Cov")


	;LateralCap        Layer      Basic      Value    RuleID         
	(LateralCap         Poly       Basic      (0.0001) "PolyLatCap")  
	(LateralCap         Metal1     Basic      (0.0001) "Metal1LatCap")
	(LateralCap         Metal2     Basic      (0.0001) "Metal2LatCap")
	(LateralCap         Metal3     Basic      (0.0001) "Metal3LatCap")


	;FringeCap         Layer1     Layer2     Value      (0.0001) RuleID         
	(FringeCap          Poly       Metal1     Basic      (0.0001) "PolyMetal1Cov")
	(FringeCap          Poly       Metal2     Basic      (0.0001) "PolyMetal2Cov")
	(FringeCap          Poly       Metal3     Basic      (0.0001) "PolyMetal3Cov")
	(FringeCap          Metal1     Poly       Basic      (0.0001) "Metal1PolyCov")
	(FringeCap          Metal1     Metal2     Basic      (0.0001) "Metal1Metal2Cov")
	(FringeCap          Metal1     Metal3     Basic      (0.0001) "Metal1Metal3Cov")
	(FringeCap          Metal2     Poly       Basic      (0.0001) "Metal2PolyCov")
	(FringeCap          Metal2     Metal1     Basic      (0.0001) "Metal2Metal1Cov")
	(FringeCap          Metal2     Metal3     Basic      (0.0001) "Metal2Metal3Cov")
	(FringeCap          Metal3     Metal2     Basic      (0.0001) "Metal3Metal2Cov")
	(FringeCap          Metal3     Metal1     Basic      (0.0001) "Metal3Metal1Cov")
) ;LayerElectricalRules


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;         BEGIN VIA/CONTACT DEFINITIONS        ;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(ViaContactDefinitions
(RoutingVia           M1_POLY1   "Metal1PolyRoutingVia"
                      (Cut                       Cont          200   200   nil   nil  )
		      (Top                       Metal1        200)
		      (Bottom                    Poly          200)
)

(Contact              M1_NIMP    "Metal1OxideContact"	
                     (Cut                       Cont          200   200   nil   nil  )
		     (Top                       Metal1        200)
		     (Bottom                    Oxide         200)
		     (Implant                   Nimp          400)
)

(Contact              M1_NWELL   "Metal1OxideContact"	
                     (Cut                       Cont          200   200   nil   nil  )
		     (Top                       Metal1        200)
		     (Bottom                    Oxide         200)
		     (Implant                   Nimp          400)
)

(Contact              M1_PIMP    "Metal1OxideContact"	
                     (Cut                       Cont          200   200   nil   nil  )
		     (Top                       Metal1        200)
		     (Bottom                    Oxide         200)
		     (Implant                   Pimp          400)
)

(Contact              M1_PSUB    "Metal1OxideContact"	
                     (Cut                       Cont          200   200   nil   nil  )
		     (Top                       Metal1        200)
		     (Bottom                    Oxide         200)
		     (Implant                   Pimp          400)
)

(RoutingVia           M2_M1      "Metal2Metal1RoutingVia"	
                     (Cut                       Via1          200   300   nil   nil  )
		     (Top                       Metal2        100)
		     (Bottom                    Metal1        100)
)

(RoutingVia           M3_M2      "Metal3Metal2RoutingVia"	
                     (Cut                       Via2          200   300   nil   nil  )
		     (Top                       Metal3        300)
		     (Bottom                    Metal2        100)
)

(RoutingVia           M4_M3      "Metal4Metal3RoutingVia"	
                     (Cut                       Via3          200   300   nil   nil  )
		     (Top                       Metal4        300)
		     (Bottom                    Metal3        100)
)

(RoutingVia           M5_M4      "Metal5Metal4RoutingVia"	
                     (Cut                       Via4          200   300   nil   nil  )
		     (Top                       Metal5        300)
		     (Bottom                    Metal4        100)
)

(RoutingVia           M6_M5      "Metal6Metal5RoutingVia"	
                     (Cut                       Via5          200   300   nil   nil  )
		     (Top                       Metal6        300)
		     (Bottom                    Metal5        100)
)
        ;;;;;;;;;;;;;;;;;
	; RESISTOR VIAS ;
	;;;;;;;;;;;;;;;;;
(Contact              M1_NPRES    "nplusres contact"	
                     (Cut         Cont          200   200   nil   nil  )
                     (Top         Metal1        200)
                     (Bottom      Oxide         200)
)
(Contact              M1_NWRES    "nwellres contact"	
                     (Cut         Cont          200   200   nil   nil  )
                     (Top         Metal1        200)
                     (Bottom      Oxide         200)
                     (Implant     Nwell         200)
)

) ;ViaContactDefinitions

(RoutingDefinitions
	(RoutingLayer         Poly       local      0   
		(LegalViaContacts          M1_POLY1 )
	)
	(RoutingLayer         Metal1     global     1   
		(LegalViaContacts          M1_POLY1 M1_NIMP M1_NWELL M1_PIMP M1_PSUB M2_M1 )
	)
	(RoutingLayer         Metal2     global     2   
		(LegalViaContacts          M2_M1 M3_M2 )
	)
	(RoutingLayer         Metal3     global     3   
		(LegalViaContacts          M3_M2 )
	)
	(RoutingLayer         Metal4     global     4  
		(LegalViaContacts          M4_M3 )
	)
	(RoutingLayer         Metal5     global     5  
		(LegalViaContacts          M5_M4 )
	)
	(RoutingLayer         Metal6     global     6  
		(LegalViaContacts          M6_M5 )
	)
) ;RoutingDefinitions

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;              BEGIN WELL DEFINITIONS          ;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(WellDefinitions
	(ExplicitWell         NwellDef  "Definition for Nwell"   
		(PhysicalWellLayer         Nwell)         ; a physical drawing layer
		(VariableWellLayer         NwellVariable) ; a physical variable layer
		(ActiveLayerAndWellHalo    Oxide  500)    ; layer plus its halo to well edge
		(ContactNameAndWellHalo    M1_NWELL 700)  ; halo around cut to well edge
		(MergeMinDistance     0)                  ; optonal
		(AutoMergeLatchupRules  75  200 10000)    ; merge%,  area-ratio,  contact-halo
	)

	(ExplicitWell         PwellDef  "Definition for Pwell"   
		(PhysicalWellLayer         Pwell)         ; a physical drawing layer
		(VariableWellLayer         PwellVariable) ; a physical variable layer
		(ActiveLayerAndWellHalo    Oxide  500)    ; layer plus its halo to well edge
		(ContactNameAndWellHalo    M1_PSUB 700)   ; halo around cut to well edge
		(MergeMinDistance     0)                  ; optonal
		(AutoMergeLatchupRules  75  200 10000)    ; merge%,  area-ratio,  contact-halo
	)

)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;           BEGIN GUARDRING DEFINITIONS        ;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(GuardRingDefinitions
	(GuardRing          NwellSingle "Single guardring for Nwell"
		(Ring        M1_NWELL 1 0 0  vdd B     "Nwell 700")
		(RingGroupLayer                Nwell 0)
	)
	(GuardRing          PwellSingle "Single guardring for Pwell"
		(Ring         M1_PSUB 1 0 0  gnd 3     "Pwell 700")
		(RingGroupLayer                Pwell 0)
	)
        (GuardRing NwellDouble "Double Ring for Nwell"
                (Ring M1_NWELL 1 0 0 vdd B "Nwell 700")
                (Ring M1_PSUB  2 1 2000 gnd B "Pwell 1700")
        )
        (GuardRing PwellDouble "Double Ring for Pwell"
                (Ring M1_PSUB 1 0 0 gnd B "Pwell 1700")
                (Ring M1_NWELL 2 1 2000 vdd "" "Nwell 700")
        )
);GuardRingDefinitions


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;       BEGIN MODULE GENERATOR DEFINITIONS        ;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(GeneratorDefinitions
(ModGen PIMA (

        ;;;;;;;;;;;;;;;;;;;;;;;;;
	; transistor parameters ;
 	;;;;;;;;;;;;;;;;;;;;;;;;;
        (W_totalWidth nil 0)
        (stackedVia   nil 1) 
        (disallowPolyRouting  nil 0)
        (useMaxRowSpacing  nil 1) 

        (sdContactName N M1_NIMP)
	(sdContactName P M1_PIMP)

	(sourceLength nil 400)
	(drainLength  nil 400)
	(sourceGapIn nil 100)
	(drainGapIn nil 100) 

	(polyViaName  nil M1_POLY1)
	(metalViaName nil M2_M1) 
        (gateExtension nil 200)

	(deviceEnclosedbyImplant nil "200 200")

	;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	; body contact parameters  ;
	;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	(bodyContactName P M1_NIMP)
	(bodyContactName N M1_PIMP)
	(bodyContactWidth nil 600)
	(bodyContactEnclosedbyImplant nil "200 200")

	;;;;;;;;;;;;;;;;;;;;;;;;;;
	; guard ring parameters  ;
	;;;;;;;;;;;;;;;;;;;;;;;;;;
	(guardRingContactName N M1_PIMP)
	(guardRingContactName P M1_NIMP)
	(guardRingWidth nil 600)
	(guardRingSpacingActive nil 500)
	(guardRingSpacingM1 nil 600)
	(guardRingSpacingPoly nil 200)
	(guardRingEnclosedbyImplant nil "200 200")


	;;;;;;;;;;;;;;;;;;;
	; well parameters ;
	;;;;;;;;;;;;;;;;;;;
	(wellName P NwellDef)
	(wellName N PwellDef)
	(activeEnclosedbyWell nil "500 500 500 500")

	;;;;;;;;;;;;;;;;;;;;;;; 
	; optional parameters ;
	;;;;;;;;;;;;;;;;;;;;;;;
	(spaceNImpPImp nil "Nimp Pimp 0")
	(spaceNImpNImp nil "Nimp Pimp 600")
	(spacePImpPImp nil "Pimp Pimp 600")
	(spacePImpActive nil "Pimp Oxide 0")
	(spaceNImpActive nil "Nimp Oxide 0")
   (latchUpRule nil 15000)
));pima

