;;  NMOS DEVICES   ;;
;;;;;;;;;;;;;;;;;;;;;

(ModGen nmos (	
));nmos

(ModGen nmos3 (
	(moduleEnclosure1 nil "Pwell {$left - 1000} {$bottom - 1000} {$right + 1000} {$top + 1000}")
));nmos3

(ModGen nmos3hv (
	(moduleEnclosure1 nil "Pwell {$left - 1000} {$bottom - 1000} {$right + 1000} {$top + 1000}")
   (deviceEnclosure1 nil "ThickOxide {$left - 250} {$bottom - 375} {$right + 250} {$top + 375}")	
   (spaceDeviceBody nil "500")
));nmos3hv

(ModGen nmoshv (
   (deviceEnclosure1 nil "ThickOxide {$left - 250} {$bottom - 375} {$right + 250} {$top + 375}")	
   (spaceDeviceBody nil "500")
));nmoshv

