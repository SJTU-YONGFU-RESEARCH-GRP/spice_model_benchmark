	;(dummyStripeRightEnclosure2 nil "metal1 {$left-100} {$activeBottom+200} {$right+1200} {$activeBottom-1000}")

        ; Add dummies poly segments to top
	;(dummyStripeTopEnclosure1 nil  "Poly {$left - max2(700-$stripeWidth/2, 0)} {$top+1900} \
	                                     ;{$right + max2(700-$stripeWidth/2, 0)} {$top+1900+800}")

	; Add dummies poly segments to bottom
	;(dummyStripeBottomEnclosure1 nil "poly {$left - max2(700-$stripeWidth/2, 0)} {$bottom-1900} \
	                                       ;{$right + max2(700-$stripeWidth/2, 0)} {$bottom-1900-800}")	
        ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	; device channel enclosure parameters   ;
	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	(deviceChannelEnclosure1 nil "PolyBlock {$left} {$bottom} {$right} {$top}")
	(deviceChannelEnclosure2 nil "Metal1Block {$left} {$bottom} {$right} {$top}")
	(deviceChannelEnclosure3 nil "Metal2Block {$left} {$bottom} {$right} {$top}")
	(deviceChannelEnclosure4 nil "Metal3Block {$left} {$bottom} {$right} {$top}")

	(guardRingWidth nil 1800)
	(guardRingSpacing nil "1800 1800 1800 1800")
	(guardRingEnclosure1 nil  "Nwell {$left-500} {$bottom-500} {$right+500} {$top+500}")
	(guardRingEnclosure2 nil  "Metal1+pin {$left} {$bottom} {$right} {$top}")
	(guardRingEnclosure3 nil  "Oxide {$left} {$bottom} {$right} {$top}")
	(guardRingEnclosure4 nil  "Cont {$left+200} {$bottom+1400} {$right-200} {$top-1400} \
	                           -stipple 1 -width 800 -spacing 500 -style fill")

        ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	; resistor interconnect parameters   ;
	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	(interconnect nil "Metal1 active 0 600 0")
	(internalViaStack1 nil "M1_POLY1 {$active + 200}")
        (externalViaStack1 nil "M1_POLY1 {$active + 200}")
	(centerPinViaStack1 nil "M1_POLY1 {$active + 200}")
	(centerPinViaStack2 nil "M2_M1  { $routeOverDevice != 0 ? $active - 1000 : $active + 1000}")
	(centerPinLayer     nil "Metal2Pin")
	(sidePinViaStack1 nil   "M2_M1  { $routeOverDevice != 0 ? $active - 600 : $active + 600}")
	(sidePinLayer     nil   "Metal2Pin")                            
	(centerRouting    nil   "Metal1  Metal1     0    600      600    {}      1") 
	(sideRouting      nil   "Metal1  Metal2   600    600      600    M2_M1   1")

	;;;;;;;;;;;;;;;;;;;;;;;;;;
	; electrical parameters  ;
	;;;;;;;;;;;;;;;;;;;;;;;;;;
	(stripeResistance  nil 	"{7.5 * $length/$width} {0.01 * $length/$width}")
	(interconnectResistance nil "{0} {0}")
	(currentCapacity nil "2.0e-3") ; A/um
));PMRAdefault

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;          BEGIN PMRA STAGGERED INFORMATION        ;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(ModGen PMRAStaggered (
        ;;;;;;;;;;;;;;;;;;;;;;;;;
	; resistor parameters   ;
	;;;;;;;;;;;;;;;;;;;;;;;;;
	(stripeSpacing nil 400)
	(maxStripesPerGroup nil 1)
	(fullLengthStripesOnly nil 1)
	(routeOverDevice nil 1)
      	(staggerStripes nil "$asymmetric && $stripeWidth < 1400")
	(staggerDistance nil 2000)

	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	; strip Enclosure parameters  ;
	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
        (stripeEnclosure1 nil  "Poly {$left} {$bottom-1100} {$right} {$top+1100}")
	(stripeEnclosure2 nil  "PolyBlock {$left} {$activeBottom} {$right} {$activeTop}")
	(stripeEnclosure3 nil  "Metal1Block {$left} {$activeBottom} {$right} {$activeTop}")
	(stripeEnclosure4 nil  "Metal2Block {$left} {$activeBottom} {$right} {$activeTop}")
	(stripeEnclosure5 nil  "Metal3Block {$left} {$activeBottom} {$right} {$activeTop}")

	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	; device Enclosure parameters  ;
	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	(deviceEnclosure1 nil   "Nwell {$left-4200} {$bottom-4200} {$right+4200} {$top+4200}")

        ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	; device channel enclosure parameters   ;
	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
        (deviceChannelEnclosure1 nil  "PolyBlock {$left} {$bottom} {$right} {$top}")
	(deviceChannelEnclosure2 nil  "Metal1Block {$left} {$bottom} {$right} {$top}")
	(deviceChannelEnclosure3 nil  "Metal2Block {$left} {$bottom} {$right} {$top}")
	(deviceChannelEnclosure4 nil  "Metal3Block {$left} {$bottom} {$right} {$top}")

	;;;;;;;;;;;;;;;;;;;;;;;;;;
	; guard ring parameters  ;
	;;;;;;;;;;;;;;;;;;;;;;;;;;
	(guardRingWidth nil 1200)
	(guardRingSpacing nil "1200 1200 1200 1200")

	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	; guard ring enclosure parameters  ;
	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	(guardRingEnclosure1 nil   "Nimp {$left-400} {$bottom-400} {$right+400} {$top+400}")
	(guardRingEnclosure2 nil   "Metal1+pin {$left} {$bottom} {$right} {$top}")
      	(guardRingEnclosure3 nil   "Oxide {$left} {$bottom} {$right} {$top}")
	(guardRingEnclosure4 nil   "Cont {$left+200} {$bottom+1400} {$right-200} {$top-1400} \
	                           -stipple 1 -width 800 -spacing 500 -style fill")

        ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	; resistor interconnect parameters   ;
	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;	
	(interconnect nil "Metal1 active -200 {max2(1200, $stripeWidth)} 0")
	(internalViaStack1 nil "M1_POLY1 {$active + 0}")
	(externalViaStack1 nil "M1_POLY1 {$active + 0}")
	(centerPinViaStack1 nil "M1_POLY1 {$active + 0}")
	(centerPinViaStack2 nil "M2_M1  {$active + 1400}")
        (centerPinLayer     nil "M2_M1")
	(sidePinViaStack1   nil "M2_M1  {($stagger != 0) ^ ($openSide == \"top\") ? $active - 1500 : $active + 1500}")
   	(sidePinLayer     nil   "Metal2Pin")                            
	(centerRouting    nil   "Metal1  Metal1      0    1200      800    {}      1") 
	(sideRouting      nil   "Metal1  Metal1      0    1200      800    {}      1")

	;;;;;;;;;;;;;;;;;;;;;;;;;;
	; electrical parameters  ;
	;;;;;;;;;;;;;;;;;;;;;;;;;;
	(stripeResistance nil   "{7.5 * $length/$width} {0.01 * $length/$width}")
	(interconnectResistance nil "{0} {0}")
	(currentCapacity nil "2.0e-3") ; A/um
));staggered


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;          BEGIN PMRA SERPENTINE INFORMATION        ;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(ModGen PMRASerpentine (
        ;;;;;;;;;;;;;;;;;;;;;;;;;
	; resistor parameters   ;
	;;;;;;;;;;;;;;;;;;;;;;;;;
	(stripeSpacing nil 800)
	(maxStripesPerGroup nil 3)
	(fullLengthStripesOnly nil 1)
	(routeOverDevice nil 0)
	(staggerStripes nil 0)
	(staggerDistance nil "not used")
	(silicideBlock nil "used")

	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	; strip Enclosure parameters  ;
	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
        (stripeEnclosure1 nil "poly {$left} {$bottom-1100} {$right} {$top+1100}")
	(stripeEnclosure2 nil "PolyBlock {$left} {$activeBottom} {$right} {$activeTop}")
	(stripeEnclosure3 nil "Metal1Block {$left} {$activeBottom} {$right} {$activeTop}")
	(stripeEnclosure4 nil "Metal2Block {$left} {$activeBottom} {$right} {$activeTop}")
	(stripeEnclosure5 nil "Metal3Block {$left} {$activeBottom} {$right} {$activeTop}")

	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	; device Enclosure parameters  ;
	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	(deviceEnclosure1 nil "nwell {$left-4200} {$bottom-4200} {$right+4200} {$top+4200}")

        ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	; device channel enclosure parameters   ;
	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	(deviceChannelEnclosure1 nil "PolyBlock {$left} {$bottom} {$right} {$top}")
	(deviceChannelEnclosure2 nil "Metal1Block {$left} {$bottom} {$right} {$top}")
	(deviceChannelEnclosure3 nil "Metal2Block {$left} {$bottom} {$right} {$top}")
	(deviceChannelEnclosure4 nil "Metal3Block {$left} {$bottom} {$right} {$top}")

	;;;;;;;;;;;;;;;;;;;;;;;;;;
	; guard ring parameters  ;
	;;;;;;;;;;;;;;;;;;;;;;;;;;
	(guardRingWidth nil 1200)
	(guardRingSpacing nil "1200 1200 1200 1200")

	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	; guard ring enclosure parameters  ;
	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	(guardRingEnclosure1 nil "nselect {$left-400} {$bottom-400} {$right+400} {$top+400}")
	(guardRingEnclosure2 nil "metal1+pin {$left} {$bottom} {$right} {$top}")
	(guardRingEnclosure3 nil "active {$left} {$bottom} {$right} {$top}")
	(guardRingEnclosure4 nil "actx {$left+200} {$bottom+1400} {$right-200} {$top-1400} \
	                          -stipple 1 -width 800 -spacing 500 -style fill")

	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	; stripe enclosure parameters  ;
	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	(enclosure1 nil "poly stripe 0 1100")
	(enclosure2 nil "PolyBlock   active 0 0")
	(enclosure3 nil "Metal1Block active 0 0")
	(enclosure4 nil "Metal2Block active 0 0")
	(enclosure5 nil "Metal3Block active 0 0")
	(enclosure6 nil "PolyBlock   devicechannels 0 0")
	(enclosure7 nil "Metal1Block devicechannels 0 0")
	(enclosure8 nil "Metal2Block devicechannels 0 0")
	(enclosure9 nil "Metal3Block devicechannels 0 0")
	(enclosure10 nil "nwell device 2200 2200")

	;;;;;;;;;;;;;;;;;;;;;;;;;;
	; guard ring parameters  ;
	;;;;;;;;;;;;;;;;;;;;;;;;;;
	(guardRing nil "NwellContact device 1000 1000 metal1pin")	

        ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	; resistor interconnect parameters   ;
	;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	(interconnect nil "poly active 0 1200 0")
	(externalViaStack1 nil "PolyContact {$active + 0}")
	(centerPinViaStack1 nil "PolyContact {$active + 0}")
	(centerPinViaStack2 nil "Metal12Via  {$active + 1200}")
	(centerPinLayer     nil "Metal2Pin")
	(sidePinViaStack1 nil   "PolyContact {$active + 0}")
	(sidePinViaStack2 nil   "Metal12Via  {$active + 1200}")
	(sidePinLayer     nil   "Metal2Pin")                            
	(centerRouting    nil   "Metal1  Metal1      0    1200      800    {}      1") 
	(sideRouting      nil   "Metal1  Metal2   1100    1200      800  Metal12Via      1")
	(centerChannel    nil	"Metal1 1200 2400 1200 {}")
	(centerDropdown1  nil   "Metal1 {$stripeX0+100} {$viaY} {$stripeX1-100} {$channelY1}")
	(sideChannel      nil   "Metal2 1200 2400 1200 Metal12Via")
	(sideDropdown1    nil   "Metal1 {$stripeX0+100} {$viaY} {$stripeX1-100} {$channelY1}")

	;;;;;;;;;;;;;;;;;;;;;;;;;;
	; electrical parameters  ;
	;;;;;;;;;;;;;;;;;;;;;;;;;;
	(stripeResistance nil "{7.5 * $length / $width} {0}")
	(interconnectResistance nil  "{7.5*($icLength/$icWidth + 0.7853981634)} {0.1}")
	; Note: 0.785... = pi / 4
	(currentCapacity nil "2.0e-3")
));serpen

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;          BEGIN PICA INFORMATION        ;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(Modgen PICA (

        ;;;;;;;;;;;;;;;;;;;;;;;;;
	; capacitor parameters  ;
	;;;;;;;;;;;;;;;;;;;;;;;;;
        (topLayerExtension nil "-2300  -2300  -2300  -2300  ")
        (topLayer nil Metal2)
        (bottomLayer nil Metal1)

        (minimumCapacitorWidth nil 3200)
        (minimumCapacitorLength nil 3200)

        (bottomContact nil "M2_M1      ew    {}     0     0      0      0      center")
        (topContact nil  "M3_M2      {}     ns    0     0      0      0      center")

        (dynamicDummyMinWidth nil 2000)
        (dynamicDummyMinLength nil 3000)

        (overlapCapPerUnitArea nil "1.0267e-6") ;  fF/nm^2

        (rowSpacing    nil 1000)
        (columnSpacing nil 1000)

        (useMaxRowSpacing nil 0)

	;;;;;;;;;;;;;;;;;;;;;;;;;;
	; guard ring parameters  ;
	;;;;;;;;;;;;;;;;;;;;;;;;;;

        (guardRingContactName N M1_PSUB)
        (guardRingContactName P M1_NWELL)
        (guardRingWidth nil 1200)
        (guardRingSpacingTopPlate nil 1200)
        (guardRingSpacingBottomPlate nil 1200)
        (guardRingSpacingRouting nil 1200)
        (guardRingEnclosedbyImplant nil "500 500")

	;;;;;;;;;;;;;;;;;;;
	; well parameters ;
	;;;;;;;;;;;;;;;;;;;
        (wellName P NwellDef)
        (wellName N PwellDef)
        (bottomPlateEnclosedbyWell nil "1500 1500 1500 1500")

));pica


    (Modgen mimcap (

        (bottomLayer nil Metal2)
        (topLayer nil Metal3)

        (bottomContact nil
        ;vianame    cside pside width length xcount ycount style
        "M2_M1      ew    {}    0     0      0      0      center")

        (topContact nil
        ;vianame    cside pside width length xcount ycount style
        "M3_M2      ew    ns    0     0      0      0      fill")

        (bottomPlateEnclosure1 nil "Capdum {$left} {$bottom} {$right} {$top}")
        (bottomPlateEnclosure2 nil "CapMetal {$left+1900} {$bottom+1900} {$right-1900} {$top-1900}")

        (overlapCapPerUnitArea nil "1.76e-6") ;  fF/nm^2
        )
    ) ; mimcap


    (ModGen gensymcross (
	; layers
        (netLayer               nil     Metal1)
        (crossLayer             nil     Metal2)
        (netPinLayer            nil     Metal1Pin)
        (geoShareLayer          nil     allGeoShare)
                        
        ; via
        (viaName                nil     M2_M1)
   
        ; specify optional blocking layers
        (blockLayers            nil     "Metal1Block Metal2Block Metal3Block")
                        
        ; spacing rules
        (spaceViaCutToNet       nil     0)
        (spaceViaCutToCross     nil     0)
        (spaceNetToNet          nil     800)
        (spaceCrossToCross      nil     800)
        )
    )
);GeneratorDefinitions
