(drDefineLineStyle
;( DisplayName   LineStyle     Size   Pattern )
  ( solid         1      (1 1 1) )
  ( dashed        1      (1 1 1 1 0 0) )
  ( dots          1      (1 0 0) )
  ( dashDot       1      (1 1 1 0 0 1 0 0) )
  ( shortDash     1      (1 1 0 0) )
  ( doubleDash    1      (1 1 1 1 0 0 1 1 0 0) )
  ( hidden        1      (1 0 0 0) )
  ( thickLine     3      (1 1 1) )
  ( thickDash     3      (1 1 1 1 0 0) )
) ;end of line style definitions

