if( avSwitch("VLC") then

load(strcat(VRFgvAssuraVerHome "AVLClayers.rul") "avlc")
 
)

CapMetal=geomOr(CapMetal CapMetal_pin)
INDdummy=geomOr(INDdummy INDdummy_pin)
JVAR1dummy=geomOr(JVAR1dummy JVAR1dummy_pin)
Metal1=geomOr(Metal1 Metal1_pin)
Metal2=geomOr(Metal2 Metal2_pin)
Metal3=geomOr(Metal3 Metal3_pin)
Metal4=geomOr(Metal4 Metal4_pin)
Metal5=geomOr(Metal5 Metal5_pin)
Metal6=geomOr(Metal6 Metal6_pin)
Nburied=geomOr(Nburied Nburied_pin)
Nimp=geomOr(Nimp Nimp_pin)
Nwell=geomOr(Nwell Nwell_pin)
Pimp=geomOr(Pimp Pimp_pin)
Poly=geomOr(Poly Poly_pin)
Pwell=geomOr(Pwell Pwell_pin)

; INDterm1=INDdummy and IND2dummy
L12859=geomAndNot(IND2dummy INDdummy)
INDterm1=geomAndNot(IND2dummy L12859)

; INDterm2=INDdummy and IND3dummy
L47036=geomAndNot(IND3dummy INDdummy)
INDterm2=geomAndNot(IND3dummy L47036)

; JVARNF=JVAR1dummy and Nwell
L21207=geomAndNot(JVAR1dummy Nwell)
JVARNF=geomAndNot(JVAR1dummy L21207)

; JVARW40=JVAR2dummy and Nwell
L43082=geomAndNot(JVAR2dummy Nwell)
JVARW40=geomAndNot(JVAR2dummy L43082)

; M1res=Metal1 and M1dummy
L62733=geomAndNot(M1dummy Metal1)
M1res=geomAndNot(M1dummy L62733)

; M1term=Metal1 andnot M1dummy
M1term=geomAndNot(Metal1 M1dummy )

; M2res=Metal2 and M2dummy
L45969=geomAndNot(M2dummy Metal2)
M2res=geomAndNot(M2dummy L45969)

; M2term=Metal2 andnot M2dummy
M2term=geomAndNot(Metal2  M2dummy )

; M3res=Metal3 and M3dummy
L87375=geomAndNot(M3dummy Metal3)
M3res=geomAndNot(M3dummy L87375)

; M3term=Metal3 andnot M3dummy
M3term=geomAndNot(Metal3 M3dummy)

; M4res=Metal4 and M4dummy
L28781=geomAndNot(M4dummy Metal4)
M4res=geomAndNot(M4dummy L28781)

; M4term=Metal4 andnot M4dummy
M4term=geomAndNot(Metal4 M4dummy)

; M5res=Metal5 and M5dummy
L70187=geomAndNot(M5dummy Metal5)
M5res=geomAndNot(M5dummy L70187)

; M5term=Metal5 andnot M5dummy
M5term=geomAndNot(Metal5 M5dummy)

; M6res=Metal6 and M6dummy
L88407=geomAndNot(M6dummy Metal6)
M6res=geomAndNot(M6dummy L88407)

; M6term=Metal6 andnot M6dummy
M6term=geomAndNot(Metal6 M6dummy)

;;;; BEGIN VPCM RULES =================================================

    M1pterm_raw = geomAnd( Metal1 geomAnd( pcm_pin1 pcm_rec ) )
    M2pterm_raw = geomAnd( Metal2 geomAnd( pcm_pin2 pcm_rec ) )
    M3pterm_raw = geomAnd( Metal3 geomAnd( pcm_pin3 pcm_rec ) )
    M4pterm_raw = geomAnd( Metal4 geomAnd( pcm_pin4 pcm_rec ) )
    M5pterm_raw = geomAnd( Metal5 geomAnd( pcm_pin5 pcm_rec ) )
    M6pterm_raw = geomAnd( Metal6 geomAnd( pcm_pin6 pcm_rec ) )

    ;;; Check pins
    M1pterm = geomOr( M1pterm_raw )
    M1pterm = geomGetTexted( M1pterm pcm_ptm1 "*")
    errorLayer( geomAndNot( M1pterm_raw M1pterm ) "VPCM pin without label" )

    M2pterm = geomOr( M2pterm_raw )
    M2pterm = geomGetTexted( M2pterm pcm_ptm2 "*")
    errorLayer( geomAndNot( M2pterm_raw M2pterm ) "VPCM pin without label" )

    M3pterm = geomOr( M3pterm_raw )
    M3pterm = geomGetTexted( M3pterm pcm_ptm3 "*")
    errorLayer( geomAndNot( M3pterm_raw M3pterm ) "VPCM pin without label" )

    M4pterm = geomOr( M4pterm_raw )
    M4pterm = geomGetTexted( M4pterm pcm_ptm4 "*")
    errorLayer( geomAndNot( M4pterm_raw M4pterm ) "VPCM pin without label" )

    M5pterm = geomOr( M5pterm_raw )
    M5pterm = geomGetTexted( M5pterm pcm_ptm5 "*")
    errorLayer( geomAndNot( M5pterm_raw M5pterm ) "VPCM pin without label" )

    M6pterm = geomOr( M6pterm_raw )
    M6pterm = geomGetTexted( M6pterm pcm_ptm6 "*")
    errorLayer( geomAndNot( M6pterm_raw M6pterm ) "VPCM pin without label" )

    M1pterm_nc = geomButting( M1pterm geomAndNot( Metal1 M1pterm ) keep < 2 )
    errorLayer(  M1pterm_nc
	"VPCM pin must have at least 2 coincident edges with the associated metal layer"
    )

    M2pterm_nc = geomButting( M2pterm geomAndNot( Metal2 M2pterm ) keep < 2 )
    errorLayer(  M2pterm_nc
	"VPCM pin must have at least 2 coincident edges with the associated metal layer"
    )

    M3pterm_nc = geomButting( M3pterm geomAndNot( Metal3 M3pterm ) keep < 2 )
    errorLayer(  M3pterm_nc
	"VPCM pin must have at least 2 coincident edges with the associated metal layer"
    )

    M4pterm_nc = geomButting( M4pterm geomAndNot( Metal4 M4pterm ) keep < 2 )
    errorLayer(  M4pterm_nc
	"VPCM pin must have at least 2 coincident edges with the associated metal layer"
    )

    M5pterm_nc = geomButting( M5pterm geomAndNot( Metal5 M5pterm ) keep < 2 )
    errorLayer(  M5pterm_nc
	"VPCM pin must have at least 2 coincident edges with the associated metal layer"
    )

    M6pterm_nc = geomButting( M6pterm geomAndNot( Metal6 M6pterm ) keep < 2 )
    errorLayer(  M6pterm_nc
	"VPCM pin must have at least 2 coincident edges with the associated metal layer"
    )
    M6pterm = geomAndNot( M6pterm M6pterm_nc )

    M1pcmcut = geomAnd( geomSize( M1pterm 0.001 ) geomInside( geomAndNot( Metal1 M1pterm ) pcm_rec ) )
    M2pcmcut = geomAnd( geomSize( M2pterm 0.001 ) geomInside( geomAndNot( Metal2 M2pterm ) pcm_rec ) )
    M3pcmcut = geomAnd( geomSize( M3pterm 0.001 ) geomInside( geomAndNot( Metal3 M3pterm ) pcm_rec ) )
    M4pcmcut = geomAnd( geomSize( M4pterm 0.001 ) geomInside( geomAndNot( Metal4 M4pterm ) pcm_rec ) )
    M5pcmcut = geomAnd( geomSize( M5pterm 0.001 ) geomInside( geomAndNot( Metal5 M5pterm ) pcm_rec ) )
    M6pcmcut = geomAnd( geomSize( M6pterm 0.001 ) geomInside( geomAndNot( Metal6 M6pterm ) pcm_rec ) )

    saveDerived( M1pcmcut ( "Metal1" "net" ) ext_view )
    saveDerived( M2pcmcut ( "Metal2" "net" ) ext_view )
    saveDerived( M3pcmcut ( "Metal3" "net" ) ext_view )
    saveDerived( M4pcmcut ( "Metal4" "net" ) ext_view )
    saveDerived( M5pcmcut ( "Metal5" "net" ) ext_view )
    saveDerived( M6pcmcut ( "Metal6" "net" ) ext_view )

    saveDerived( M1pterm ( "Metal1" "net" ) ext_view )
    saveDerived( M2pterm ( "Metal2" "net" ) ext_view )
    saveDerived( M3pterm ( "Metal3" "net" ) ext_view )
    saveDerived( M4pterm ( "Metal4" "net" ) ext_view )
    saveDerived( M5pterm ( "Metal5" "net" ) ext_view )
    saveDerived( M6pterm ( "Metal6" "net" ) ext_view )

    pterm1 = geomOr(
	geomGetTexted( M1pterm pcm_ptm1 "P1" )
	geomGetTexted( M2pterm pcm_ptm2 "P1" )
	geomGetTexted( M3pterm pcm_ptm3 "P1" )
	geomGetTexted( M4pterm pcm_ptm4 "P1" )
	geomGetTexted( M5pterm pcm_ptm5 "P1" )
	geomGetTexted( M6pterm pcm_ptm6 "P1" )
    )
    pterm2 = geomOr(
	geomGetTexted( M1pterm pcm_ptm1 "P2" )
	geomGetTexted( M2pterm pcm_ptm2 "P2" )
	geomGetTexted( M3pterm pcm_ptm3 "P2" )
	geomGetTexted( M4pterm pcm_ptm4 "P2" )
	geomGetTexted( M5pterm pcm_ptm5 "P2" )
	geomGetTexted( M6pterm pcm_ptm6 "P2" )
    )
    pterm3 = geomOr(
	geomGetTexted( M1pterm pcm_ptm1 "P3" )
	geomGetTexted( M2pterm pcm_ptm2 "P3" )
	geomGetTexted( M3pterm pcm_ptm3 "P3" )
	geomGetTexted( M4pterm pcm_ptm4 "P3" )
	geomGetTexted( M5pterm pcm_ptm5 "P3" )
	geomGetTexted( M6pterm pcm_ptm6 "P3" )
    )
    pterm4 = geomOr(
	geomGetTexted( M1pterm pcm_ptm1 "P4" )
	geomGetTexted( M2pterm pcm_ptm2 "P4" )
	geomGetTexted( M3pterm pcm_ptm3 "P4" )
	geomGetTexted( M4pterm pcm_ptm4 "P4" )
	geomGetTexted( M5pterm pcm_ptm5 "P4" )
	geomGetTexted( M6pterm pcm_ptm6 "P4" )
    )
    pterm5 = geomOr(
	geomGetTexted( M1pterm pcm_ptm1 "P5" )
	geomGetTexted( M2pterm pcm_ptm2 "P5" )
	geomGetTexted( M3pterm pcm_ptm3 "P5" )
	geomGetTexted( M4pterm pcm_ptm4 "P5" )
	geomGetTexted( M5pterm pcm_ptm5 "P5" )
	geomGetTexted( M6pterm pcm_ptm6 "P5" )
    )
    pterm6 = geomOr(
	geomGetTexted( M1pterm pcm_ptm1 "P6" )
	geomGetTexted( M2pterm pcm_ptm2 "P6" )
	geomGetTexted( M3pterm pcm_ptm3 "P6" )
	geomGetTexted( M4pterm pcm_ptm4 "P6" )
	geomGetTexted( M5pterm pcm_ptm5 "P6" )
	geomGetTexted( M6pterm pcm_ptm6 "P6" )
    )
    tterm1 = geomOr(
	geomGetTexted( M1pterm pcm_ptm1 "T1" )
	geomGetTexted( M2pterm pcm_ptm2 "T1" )
	geomGetTexted( M3pterm pcm_ptm3 "T1" )
	geomGetTexted( M4pterm pcm_ptm4 "T1" )
	geomGetTexted( M5pterm pcm_ptm5 "T1" )
	geomGetTexted( M6pterm pcm_ptm6 "T1" )
    )
    tterm2 = geomOr(
	geomGetTexted( M1pterm pcm_ptm1 "T2" )
	geomGetTexted( M2pterm pcm_ptm2 "T2" )
	geomGetTexted( M3pterm pcm_ptm3 "T2" )
	geomGetTexted( M4pterm pcm_ptm4 "T2" )
	geomGetTexted( M5pterm pcm_ptm5 "T2" )
	geomGetTexted( M6pterm pcm_ptm6 "T2" )
    )

    ;;; Disconnect the inside metal from the outside
    ;;; This will allow the inside metal connectivity to be separately checked
    M1term = geomAndNot( M1term M1pcmcut )
    M2term = geomAndNot( M2term M2pcmcut )
    M3term = geomAndNot( M3term M3pcmcut )
    M4term = geomAndNot( M4term M4pcmcut )
    M5term = geomAndNot( M5term M5pcmcut )
    M6term = geomAndNot( M6term M6pcmcut )

    ;;; Special recognition of the PCM SmplInd and DiffInd
    ;;; Later we can add more detailed checking and extraction for these devices
    pcm_smpl_ind_rec =  geomGetTexted( pcm_rec pcm_text "SmplInd" )
    pcm_diff_ind_rec =  geomGetTexted( pcm_rec pcm_text "DiffInd" )
    pcm_diffnotap_ind_rec =  geomGetTexted( pcm_rec pcm_text "DiffIndNoTap" )
    pcm_rec = geomAndNot( pcm_rec geomOr( pcm_smpl_ind_rec pcm_diff_ind_rec pcm_diffnotap_ind_rec) )

;;;; END VPCM RULES =================================================


; Testing rule additions - contact resistnace

Cont_res=geomButting(Cont Resdum)
Cont = geomAndNot(Cont Cont_res)

; NPLUS=Nimp and Oxide
L47238=geomAndNot(Nimp Oxide)
NPLUS=geomAndNot(Nimp L47238)

; NSD=NPLUS andnot Poly
NSD=geomAndNot(NPLUS Poly)

; NSDcont=Cont and NPLUS
L38175=geomAndNot(Cont NPLUS)
NSDcont=geomAndNot(Cont L38175)
NSDcont_res = geomAnd(Cont_res NPLUS)

; NSDterm=NSD andnot Resdum
NSDterm=geomAndNot(NSD Resdum)

; NWELLRES=Nwell and ResWdum
L63256=geomAndNot(Nwell ResWdum)
NWELLRES=geomAndNot(Nwell L63256)

; NWELLterm=Nwell andnot ResWdum
NWELLterm=L63256

; NBVIA=NWELLterm and Nburied
L30842=geomAndNot(NWELLterm Nburied)
NBVIA=geomAndNot(NWELLterm L30842)

; NWVIA=NSDterm and NWELLterm
L2618=geomAndNot(NSDterm NWELLterm)
NWVIA=geomAndNot(NSDterm L2618)

; POLYcont=Cont and Poly
L92161=geomAndNot(Cont Poly)
POLYcont=geomAndNot(Cont L92161)
POLYcont_res=geomAnd(Cont_res Poly)

; POLYterm=Poly andnot Resdum
POLYterm=geomAndNot(Poly Resdum)

; PPLUS=Pimp and Oxide
L39038=geomAndNot(Oxide Pimp)
PPLUS=geomAndNot(Oxide L39038)

; PSD=PPLUS andnot Poly
PSD=geomAndNot(PPLUS Poly)

; PSDcont=Cont and PPLUS
L96477=geomAndNot(Cont PPLUS)
PSDcont=geomAndNot(Cont L96477)
PSDcont_res=geomAnd(Cont_res PPLUS)

; PSDterm=PSD andnot Resdum
PSDterm=geomAndNot(PSD Resdum)

; Via2Cap=Via2 and CapMetal
L65736=geomAndNot(Via2 CapMetal)
Via2Cap=geomAndNot(Via2 L65736)

; INDterm1Cont=Metal2 and INDdummy and IND2dummy
L45833=geomAndNot(INDdummy Metal2)
L41497=geomAndNot(INDdummy L45833)
L28453=geomAndNot(IND2dummy L41497)
INDterm1Cont=geomAndNot(IND2dummy L28453)

; INDterm2Cont=Metal2 and INDdummy and IND3dummy
L30172=geomAndNot(IND3dummy L41497)
INDterm2Cont=geomAndNot(IND3dummy L30172)

; ISONSDRES=NSD and Resdum and Nburied
L29658=geomAndNot(NSD NSDterm)
L65572=geomAndNot(L29658 Nburied)
ISONSDRES=geomAndNot(L29658 L65572)

; JVARanode=(JVAR1dummy or JVAR2dummy) andnot NSDterm 
L74850=geomOr(JVAR1dummy JVAR2dummy)
JVARanode=geomAndNot(L74850 NSDterm)

; MIMCAP=CapMetal and Metal2 and Capdum
L16547=geomAndNot(CapMetal Metal2)
L62925=geomAndNot(CapMetal L16547)
L74863=geomAndNot(Capdum L62925)
MIMCAP=geomAndNot(Capdum L74863)

; NDIODE=DIOdummy and ( NSDterm andnot Nwell )
L83619=geomAndNot(NSDterm Nwell)
L58816=geomAndNot(DIOdummy L83619)
NDIODE=geomAndNot(DIOdummy L58816)

; NSDRES=NSD and Resdum andnot Nburied
NSDRES=L65572

; PDIODE=DIOdummy and PSDterm and Nwell
L91826=geomAndNot(DIOdummy PSDterm)
L33580=geomAndNot(DIOdummy L91826)
L68348=geomAndNot(L33580 Nwell)
PDIODE=geomAndNot(L33580 L68348)

; POLYHRES=Poly and Resdum and SiProt
L99065=geomAndNot(Poly POLYterm)
L1343=geomAndNot(L99065 SiProt)
POLYHRES=geomAndNot(L99065 L1343)

; POLYRES=Poly and Resdum andnot SiProt
POLYRES=L1343

; PSDRES=PPLUS and Resdum and Nwell
L46169=geomAndNot(PPLUS Resdum)
L77701=geomAndNot(PPLUS L46169)
L78225=geomAndNot(L77701 Nwell)
PSDRES=geomAndNot(L77701 L78225)

; PWVIA=(PSDterm and Pwell) andnot Nwell
L12622=geomAndNot(PSDterm Pwell)
L33566=geomAndNot(PSDterm L12622)
PWVIA=geomAndNot(L33566 Nwell)

; INDUCTOR=(Metal3 or IND2dummy or IND3dummy) and INDdummy
L32940=geomOr(IND2dummy Metal3)
L19763=geomOr(IND3dummy L32940)
L11106=geomAndNot(INDdummy L19763)
INDUCTOR=geomAndNot(INDdummy L11106)

; JVARterm=PSDterm and (JVAR1dummy or JVAR2dummy) and JVAR3dummy
L9410=geomAndNot(L74850 PSDterm)
L40384=geomAndNot(L74850 L9410)
L19996=geomAndNot(JVAR3dummy L40384)
JVARterm=geomAndNot(JVAR3dummy L19996)

; NPN=NPNdummy and Pwell and Nburied and NSDterm
L41825=geomAndNot(NPNdummy Pwell)
L77885=geomAndNot(NPNdummy L41825)
L33785=geomAndNot(L77885 Nburied)
L63415=geomAndNot(L77885 L33785)
L9889=geomAndNot(L63415 NSDterm)
NPN=geomAndNot(L63415 L9889)

; PMOSCAP=POLYterm and Nwell and PPLUS and Capdum
L34941=geomAndNot(Nwell POLYterm)
L8539=geomAndNot(Nwell L34941)
L56960=geomAndNot(L8539 PPLUS)
L93040=geomAndNot(L8539 L56960)
L19485=geomAndNot(Capdum L93040)
PMOSCAP=geomAndNot(Capdum L19485)

; Via2NoCapInd=Via2 and Metal2 andnot (CapMetal or INDdummy)
L74578=geomAndNot(Via2 Metal2)
L98704=geomAndNot(Via2 L74578)
L47735=geomOr(CapMetal INDdummy)
Via2NoCapInd=geomAndNot(L98704 L47735)

; ISONMOSCAP=POLYterm andnot Nwell and NPLUS and Capdum and Nburied
L26152=geomAndNot(POLYterm Nwell)
L17363=geomAndNot(L26152 NPLUS)
L2255=geomAndNot(L26152 L17363)
L64413=geomAndNot(Capdum L2255)
L68673=geomAndNot(Capdum L64413)
L64962=geomAndNot(L68673 Nburied)
ISONMOSCAP=geomAndNot(L68673 L64962)

; NMOSCAP=POLYterm andnot Nwell and NPLUS and Capdum andnot Nburied
NMOSCAP=L64962

; PMOS=POLYterm and Nwell and PPLUS andnot ThickOxide andnot Capdum
L56230=geomAndNot(L93040 ThickOxide)
PMOS=geomAndNot(L56230 Capdum)

; PMOSHV=POLYterm and Nwell and PPLUS and ThickOxide andnot Capdum
L68469=geomAndNot(L93040 L56230)
PMOSHV=geomAndNot(L68469 Capdum)

; PNP=PNPdummy and Nwell and Pwell and Nburied and PSDterm
L49889=geomAndNot(Nwell PNPdummy)
L99549=geomAndNot(Nwell L49889)
L23789=geomAndNot(L99549 Pwell)
L64651=geomAndNot(L99549 L23789)
L90502=geomAndNot(L64651 Nburied)
L49368=geomAndNot(L64651 L90502)
L64552=geomAndNot(L49368 PSDterm)
PNP=geomAndNot(L49368 L64552)

; PSUB=(bulk andnot (Nburied or Nwell or Pwell)) or BJTdum
; psubstrate=(bulk andnot (Nburied and Nwell)) andnot (Psub andnot (Psub size -0.001))
;  andnot NPNdummy
L43094=geomOr(Nburied Nwell)
L15547=geomOr(L43094 Pwell)
L71054=geomAndNot(bulk L15547)
L12316=geomOr(BJTdum L71054)
; added code from here
L86601=geomSize(Psubiso -0.001)
L7495=geomAndNot(Psubiso L86601)
PSUB=geomAndNot(L12316 L7495)


; SUBVIA=(PSUB and PSDterm) andnot Nburied andnot Nwell
L34070=geomAndNot(PSDterm PSUB)
L6892=geomAndNot(PSDterm L34070)
L56122=geomAndNot(L6892 Nburied)
SUBVIA=geomAndNot(L56122 Nwell)

; ISONMOS=POLYterm andnot Nwell and NPLUS andnot ThickOxide andnot Capdum and Nburied
L53692=geomAndNot(L2255 ThickOxide)
L70081=geomAndNot(L53692 Capdum)
L47102=geomAndNot(L70081 Nburied)
ISONMOS=geomAndNot(L70081 L47102)

; ISONMOSHV=POLYterm andnot Nwell and NPLUS and ThickOxide andnot Capdum and Nburied
L28865=geomAndNot(L2255 L53692)
L34783=geomAndNot(L28865 Capdum)
L45699=geomAndNot(L34783 Nburied)
ISONMOSHV=geomAndNot(L34783 L45699)

; ISOPWELL=((Nburied enclose (holes Nwell)) and (holes Nwell))andnot Pwell
L85630=geomHoles(Nwell)
L90545=geomAndNot(L85630 Nwell)
L50707=geomEnclose(Nburied L90545)
L35619=geomAndNot(L50707 L90545)
L9133=geomAndNot(L50707 L35619)
ISOPWELL=geomAndNot(L9133 Pwell)

; PWNBVIA=(PSDterm and ISOPWELL)
L92787=geomAndNot(ISOPWELL PSDterm)
PWNBVIA=geomAndNot(ISOPWELL L92787)

; NMOS=POLYterm andnot Nwell and NPLUS andnot ThickOxide andnot Capdum andnot Nburied
NMOS=L47102

; NMOSHV=POLYterm andnot Nwell and NPLUS and ThickOxide andnot Capdum andnot Nburied
NMOSHV=L45699

; VPNP=(PSDterm and Nwell) touch (holes(PSDterm) touch holes(NSDterm) notouch Poly) and BJTdum
L51728=geomAndNot(Nwell PSDterm)
L22688=geomAndNot(Nwell L51728)
L98291=geomHoles(PSDterm)
L40992=geomAndNot(L98291 PSDterm)
L48335=geomHoles(NSDterm)
L66370=geomAndNot(L48335 NSDterm)
L50165=geomButtOrOver(L40992 L66370)
L64385=geomAvoiding(L50165 Poly)
L44859=geomButtOrOver(L22688 L64385)
L18823=geomAndNot(BJTdum L44859)
VPNP=geomAndNot(BJTdum L18823)

M1term_device = geomAnd( M1term geomOr( JVAR1dummy JVAR2dummy ) )
M1term = geomAndNot( M1term M1term_device )


; VeloceRF 
