    extractDevice( "pcm_simshort" M5pcmcut M5term("P1" "P2")
	cellView("pcm_simshort ivpcell vpcmLib")
    )
    extractDevice( "pcm_simshort" M6pcmcut M6term("P1" "P2")
	cellView("pcm_simshort ivpcell vpcmLib")
    )
)
