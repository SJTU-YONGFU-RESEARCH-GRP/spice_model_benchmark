nf=calculateParameter((perimeter - 85.2) / 3.6)
attachParameter(nf "nf" JVARNF)

extractDIODE("xjvar_nf36" JVARW40 JVARanode("ANODE") NWELLterm("CATHODE")
    PSUB("BULK") cellView("xjvar_nf36 ivpcell gpdk180"))
