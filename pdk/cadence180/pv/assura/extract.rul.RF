	    textProperty(pcm_text)
    )
    saveProperty( pcm_diffnotap_ind_rec "model" "DiffIndNoTap" )
    saveRecognition(  pcm_diffnotap_ind_rec "device" )

    extractDevice( "pcm6" pcm_rec pterm1("P1") pterm2("P2") pterm3("P3") pterm4("P4") pterm5("P5") pterm6("P6") PSUB("B")
	    namePrefix("X")
	    cellView("pcm6 ivpcell vpcmLib")
	    textProperty(pcm_text)
    )

    extractDevice( "pcm5" pcm_rec pterm1("P1") pterm2("P2") pterm3("P3") pterm4("P4") pterm5("P5") PSUB("B")
	    namePrefix("X")
	    cellView("pcm5 ivpcell vpcmLib")
	    textProperty(pcm_text)
    ) 

    extractDevice( "pcm4" pcm_rec pterm1("P1") pterm2("P2") pterm3("P3") pterm4("P4") PSUB("B")
	    namePrefix("X")
	    cellView("pcm4 ivpcell vpcmLib")
	    textProperty(pcm_text)
    )

    extractDevice( "pcm3" pcm_rec pterm1("P1") pterm2("P2") pterm3("P3") PSUB("B")
	    namePrefix("X")
	    cellView("pcm3 ivpcell vpcmLib")
	    textProperty(pcm_text)
    )

    extractDevice( "pcm2" pcm_rec pterm1("P1") pterm2("P2") PSUB("B")
	    namePrefix("X")
	    cellView("pcm2 ivpcell vpcmLib")
	    textProperty(pcm_text)
    )

    saveRecognition( pcm_rec "device" )

    ;;; Extract open devices for internal connectivity checking support
    extractDevice( "pcm_simopen" M1pcmcut M1term("P1" "P2")
	cellView("pcm_simopen ivpcell vpcmLib")
    )
    extractDevice( "pcm_simopen" M2pcmcut M2term("P1" "P2")
	cellView("pcm_simopen ivpcell vpcmLib")
    )
    extractDevice( "pcm_simopen" M3pcmcut M3term("P1" "P2")
	cellView("pcm_simopen ivpcell vpcmLib")
    )
    extractDevice( "pcm_simopen" M4pcmcut M4term("P1" "P2")
	cellView("pcm_simopen ivpcell vpcmLib")
    )
    extractDevice( "pcm_simopen" M5pcmcut M5term("P1" "P2")
	cellView("pcm_simopen ivpcell vpcmLib")
    )
    extractDevice( "pcm_simopen" M6pcmcut M6term("P1" "P2")
	cellView("pcm_simopen ivpcell vpcmLib")
    )
else

    ;;; Extract shorting devices for Assura PL post-layout simulation
    extractDevice( "pcm_simshort" M1pcmcut M1term("P1" "P2")
	cellView("pcm_simshort ivpcell vpcmLib")
    )
    extractDevice( "pcm_simshort" M2pcmcut M2term("P1" "P2")
	cellView("pcm_simshort ivpcell vpcmLib")
    )
