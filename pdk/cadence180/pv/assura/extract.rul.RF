load(strcat(VRFgvAssuraVerHome "AVLCdefinemetals.rul") "avlc")
load(strcat(VRFgvAssuraVerHome "AVLCdevicederiv.rul") "avlc")

)

if( avSwitch( "HF" ) then

          shM1 = geomAnd( M1term y1 )
          M1term = geomAndNot( M1term shM1 )
          shM1_term = geomAnd( geomSize( shM1 0.05 ) M1term )

          shM2 = geomAnd( M2term y2 )
          M2term = geomAndNot( M2term shM2 )
          shM2_term = geomAnd( geomSize( shM2 0.05 ) M2term )

          shM3 = geomAnd( M3term y3 )
          M3term = geomAndNot( M3term shM3 )
          shM3_term = geomAnd( geomSize( shM3 0.05 ) M3term )

          shM4 = geomAnd( M4term y4 )
          M4term = geomAndNot( M4term shM4 )
          shM4_term = geomAnd( geomSize( shM4 0.05 ) M4term )

          shM5 = geomAnd( M5term y5 )
          M5term = geomAndNot( M5term shM5 )
          shM5_term = geomAnd( geomSize( shM5 0.05 ) M5term )

          shM6 = geomAnd( M6term y6 )
          M6term = geomAndNot( M6term shM6 )
          shM6_term = geomAnd( geomSize( shM6 0.06 ) M6term )

) ; end if


if( !avSwitch( "VLC" ) then

geomConnect(
    via(Via5 M6term M5term)
    via(Via4 M5term M4term)
    via(Via3 M4term M3term)
    via(Via2NoCapInd M3term M2term)
    via(Via2Cap M3term CapMetal)
    via(Via1 M2term M1term)
    via(INDterm1Cont M2term INDterm1)
    via(INDterm2Cont M2term INDterm2)
    via(POLYcont M1term POLYterm)
    via(POLYcont_res M1term POLYterm)
    via(PSDcont M1term PSDterm M1term_device)
    via(PSDcont_res M1term PSDterm M1term_device)
    via(NSDcont M1term NSDterm M1term_device)
    via(NSDcont_res M1term NSDterm M1term_device)
    label(Metal6_label M6term)
    label(Metal5_label M5term)
    label(Metal4_label M4term)
    label(Metal3_label M3term)
    label(Metal2_label M2term)
    label(Metal1_label M1term)
    label(Metal6_text M6term)
    label(Metal6_pintext M6term)
    label(Metal5_text M5term)
    label(Metal5_pintext M5term)
    label(Metal4_text M4term)
    label(Metal4_pintext M4term)
    label(Metal3_text M3term)
    label(Metal3_pintext M3term)
    label(Metal2_text M2term)
    label(Metal2_pintext M2term)
    label(Metal1_text M1term)
    label(Metal1_pintext M1term)
    label(Metal1_text M1term_device)
    label(Metal1_pintext M1term_device)
    buttOrOver(M1term_device M1term)
    ;;; Begin VPCM
    buttOrOver( M1pterm M1term )
    buttOrOver( M2pterm M2term )
    buttOrOver( M3pterm M3term )
    buttOrOver( M4pterm M4term )
    buttOrOver( M5pterm M5term )
    buttOrOver( M6pterm M6term )
    overlap( pterm1 M1pterm )
    overlap( pterm1 M2pterm )
    overlap( pterm1 M3pterm )
    overlap( pterm1 M4pterm )
    overlap( pterm1 M5pterm )
    overlap( pterm1 M6pterm )

    overlap( pterm2 M1pterm )
    overlap( pterm2 M2pterm )
    overlap( pterm2 M3pterm )
    overlap( pterm2 M4pterm )
    overlap( pterm2 M5pterm )
    overlap( pterm2 M6pterm )

    overlap( pterm3 M1pterm )
    overlap( pterm3 M2pterm )
    overlap( pterm3 M3pterm )
    overlap( pterm3 M4pterm )
    overlap( pterm3 M5pterm )
    overlap( pterm3 M6pterm )

    overlap( pterm4 M1pterm )
    overlap( pterm4 M2pterm )
    overlap( pterm4 M3pterm )
    overlap( pterm4 M4pterm )
    overlap( pterm4 M5pterm )
    overlap( pterm4 M6pterm )

    overlap( pterm5 M1pterm )
    overlap( pterm5 M2pterm )
    overlap( pterm5 M3pterm )
    overlap( pterm5 M4pterm )
    overlap( pterm5 M5pterm )
    overlap( pterm5 M6pterm )

    overlap( pterm6 M1pterm )
    overlap( pterm6 M2pterm )
    overlap( pterm6 M3pterm )
    overlap( pterm6 M4pterm )
    overlap( pterm6 M5pterm )
    overlap( pterm6 M6pterm )

    overlap( tterm1 M1pterm )
    overlap( tterm1 M2pterm )
    overlap( tterm1 M3pterm )
    overlap( tterm1 M4pterm )
    overlap( tterm1 M5pterm )
    overlap( tterm1 M6pterm )

    overlap( tterm2 M1pterm )
    overlap( tterm2 M2pterm )
    overlap( tterm2 M3pterm )
    overlap( tterm2 M4pterm )
    overlap( tterm2 M5pterm )
    overlap( tterm2 M6pterm )

)

)

