    extractDevice( "SmplInd" pcm_smpl_ind_rec pterm1("P1") pterm2("P2") PSUB("B")
	namePrefix("X")
        cellView("SmplInd ivpcell vpcmLib")
	textProperty(pcm_text)
    )
    saveProperty( pcm_smpl_ind_rec "model" "SmplInd" )
