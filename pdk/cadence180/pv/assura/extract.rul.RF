;SNA rules

if( avSwitch( "HF") then

;;load("./HFextract.rul")

nwell_sna= geomAvoiding( Nwell geomOr( NWELLRES PNP NPN VPNP JVARW40 JVARNF) )
dnwell_sna= geomAnd(nwell_sna Nburied)
tpwell_sna= geomAvoiding( geomAndNot( Nburied Nwell ) geomOr( PNP NPN VPNP ) )

ptie_sna = geomOr( geomAndNot( PWVIA tpwell_sna ) SUBVIA )
tpwtie_sna = geomOr( geomAnd( PWVIA tpwell_sna ) PWNBVIA )
ntie_sna = geomAnd( NWVIA nwell_sna )
dnwtie_sna = geomAnd( NWVIA dnwell_sna )

ptie_term_sna = geomOr( ptie_sna )
tpwtie_term_sna = geomOr( tpwtie_sna )
ntie_term_sna = geomOr( ntie_sna )
dnwtie_term_sna = geomOr( dnwtie_sna )

  geomStamp( shM1_term M1term )
  geomStamp( shM2_term M2term )
  geomStamp( shM3_term M3term )
  geomStamp( shM4_term M4term )
  geomStamp( shM5_term M5term )
  geomStamp( shM6_term M6term )

  geomStamp( ptie_term_sna M1term )
  geomStamp( tpwtie_term_sna M1term )
  geomStamp( ntie_term_sna M1term )
  geomStamp( dnwtie_term_sna M1term )

extractRES( "short" shM1 shM1_term("MINUS" "PLUS") cellView( "short ivpcell substrateLib" ) )
extractRES( "short" shM2 shM2_term("MINUS" "PLUS") cellView( "short ivpcell substrateLib" ) )
extractRES( "short" shM3 shM3_term("MINUS" "PLUS") cellView( "short ivpcell substrateLib" ) )
extractRES( "short" shM4 shM4_term("MINUS" "PLUS") cellView( "short ivpcell substrateLib" ) )
extractRES( "short" shM5 shM5_term("MINUS" "PLUS") cellView( "short ivpcell substrateLib" ) )
extractRES( "short" shM6 shM6_term("MINUS" "PLUS") cellView( "short ivpcell substrateLib" ) )

extractDevice( "TIE" ptie_sna ptie_term_sna("P1") )
extractDevice( "TIE" tpwtie_sna tpwtie_term_sna("P1") )
extractDevice( "TIE" ntie_sna ntie_term_sna("P1") )
extractDevice( "TIE" dnwtie_sna dnwtie_term_sna("P1") )

saveProperty( shM1 "r" "1e-09" )
saveProperty( shM2 "r" "1e-09" )
saveProperty( shM3 "r" "1e-09" )
saveProperty( shM4 "r" "1e-09" )
saveProperty( shM5 "r" "1e-09" )
saveProperty( shM6 "r" "1e-09" )


saveDerived( nwell_sna ( "SNA" "nwell" ) ext_view )
saveDerived( dnwell_sna ( "SNA" "nwelld" ) ext_view )
saveDerived( tpwell_sna ( "SNA" "tpwell" ) ext_view )

saveRecognition( shM1 "device" )
saveRecognition( shM2 "device" )
saveRecognition( shM3 "device" )
saveRecognition( shM4 "device" )
saveRecognition( shM5 "device" )
saveRecognition( shM6 "device" )

saveRecognition( NSDRES "device" )
saveRecognition( ISONSDRES "device" )
saveRecognition( PSDRES "device" )
saveRecognition( PMOSCAP "device" )
saveRecognition( NMOSCAP "device" )
saveRecognition( MIMCAP "device" )
saveRecognition( ISONMOSCAP "device" )
saveRecognition( NMOS "device" )
saveRecognition( ISONMOS "device" )
saveRecognition( NMOSHV "device" )
saveRecognition( ISONMOSHV "device" )
saveRecognition( PMOS "device" )
saveRecognition( PMOSHV "device" )
saveRecognition( ptie_sna "device" )
saveRecognition( tpwtie_sna "device" )
saveRecognition( ntie_sna "device" )
saveRecognition( dnwtie_sna "device" )
saveRecognition( JVARNF "device" )
saveRecognition( JVARW40 "device" )

)


processAntenna(
   gate( (SUBVIA PSDterm) )
   antenna(SUBVIA)
   ant=drcAntenna(SUBVIA (SUBVIA) keep >0 "psub connections")
   )

)

;;; The following line must be located **OUTSIDE** of the drcExtractRules section.
;;; Otherwise VLC inductor extraction will be incomplete and Assura LVS will
;;; report parameter mismatches for the inductors - JM 01/04/06
load(strcat(VRFgvAssuraVerHome "AVLCextClb.rul") "avlc")
