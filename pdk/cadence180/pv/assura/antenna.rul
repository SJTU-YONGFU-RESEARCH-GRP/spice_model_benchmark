drcExtractRules(

layerDefs("GDS2"

    CapMetal=layer( 14 type(0) )

    Cont=layer( 6 type(0) )

    INDdummy=layer( 16 type(0) )

    Metal1=layer( 7 type(0) )
    Metal1_text=textToPin( 7 type(3) )

    Metal2=layer( 9 type(0) )
    Metal2_text=textToPin( 9 type(3) )

    Metal3=layer( 11 type(0) )
    Metal3_text=textToPin( 11 type(3) )

    Metal4=layer( 31 type(0) )
    Metal4_text=textToPin( 31 type(3) )

    Metal5=layer( 33 type(0) )
    Metal5_text=textToPin( 33 type(3) )

    Metal6=layer( 35 type(0) )
    Metal6_text=textToPin( 35 type(3) )

    Nimp=layer( 4 type(0) )

    Nwell=layer( 2 type(0) )

    Oxide=layer( 1 type(0) )

    Pimp=layer( 5 type(0) )

    Poly=layer( 3 type(0) )

    Via1=layer( 8 type(0) )

    Via2=layer( 10 type(0) )

    Via3=layer( 30 type(0) )

    Via4=layer( 32 type(0) )

    Via5=layer( 34 type(0) )

)

layerDefs("df2"

    CapMetal=layer("CapMetal" type("drawing"))

    Cont=layer("Cont" type("drawing"))

    INDdummy=layer("INDdummy" type("drawing"))

    Metal1=layer("Metal1" type("drawing"))
    Metal1_text=textToPin("Metal1" type("label"))

    Metal2=layer("Metal2" type("drawing"))
    Metal2_text=textToPin("Metal2" type("label"))

    Metal3=layer("Metal3" type("drawing"))
    Metal3_text=textToPin("Metal3" type("label"))

    Metal4=layer("Metal4" type("drawing"))
    Metal4_text=textToPin("Metal4" type("label"))

    Metal5=layer("Metal5" type("drawing"))
    Metal5_text=textToPin("Metal5" type("label"))

    Metal6=layer("Metal6" type("drawing"))
    Metal6_text=textToPin("Metal6" type("label"))

    Nimp=layer("Nimp" type("drawing"))

    Nwell=layer("Nwell" type("drawing"))

    Oxide=layer("Oxide" type("drawing"))

    Pimp=layer("Pimp" type("drawing"))

    Poly=layer("Poly" type("drawing"))

    Via1=layer("Via1" type("drawing"))

    Via2=layer("Via2" type("drawing"))

    Via3=layer("Via3" type("drawing"))

    Via4=layer("Via4" type("drawing"))

    Via5=layer("Via5" type("drawing"))

)


; Contdum=Cont and Metal1
Contdum=geomAnd(Cont Metal1)

; NPLUS=Nimp and Oxide
NPLUS=geomAnd(Nimp Oxide)

; PPLUS=Pimp and Oxide
PPLUS=geomAnd(Oxide Pimp)

; Via1dum=Via1 and Metal2
Via1dum=geomAnd(Metal2 Via1)

; Via3dum=Via3 and Metal4
Via3dum=geomAnd(Metal4 Via3)

; Via4dum=Via4 and Metal5
Via4dum=geomAnd(Metal5 Via4)

; Via5dum=Via5 and Metal6
Via5dum=geomAnd(Metal6 Via5)

; Via2NoCapInd=Via2 and Metal2 andnot (CapMetal or INDdummy)
L98704=geomAnd(Metal2 Via2)
L47735=geomOr(CapMetal INDdummy)
Via2NoCapInd=geomAndNot(L98704 L47735)

; Via2dum=Via2NoCapInd and Metal3
Via2dum=geomAnd(Metal3 Via2NoCapInd)

; ALL_GATES=( Poly and NPLUS andnot Nwell ) or ( Poly and PPLUS and Nwell )
L75885=geomAnd(NPLUS Poly)
L93899=geomAndNot(L75885 Nwell)
L48875=geomAnd(PPLUS Poly)
L44203=geomAnd(L48875 Nwell)
ALL_GATES=geomOr(L44203 L93899)

; FIELD_POLY1=Poly andnot ALL_GATES
FIELD_POLY1=geomAndNot(Poly ALL_GATES)

; FIELD_POLY1_CONNECT=FIELD_POLY1 and Poly
FIELD_POLY1_CONNECT=geomAnd(FIELD_POLY1 Poly)


geomConnect(
    via(FIELD_POLY1_CONNECT FIELD_POLY1 Poly)
)

processAntenna(
    gate((ALL_GATES Poly))
    antenna(FIELD_POLY1)
    ratio1=FIELD_POLY1.area/ALL_GATES.area
    drcAntenna(FIELD_POLY1 (ALL_GATES Poly FIELD_POLY1) ratio1 keep>100.0
        "ant0: illegal antenna ratio")
)

geomConnect(
    via(Cont Metal1 Poly)
