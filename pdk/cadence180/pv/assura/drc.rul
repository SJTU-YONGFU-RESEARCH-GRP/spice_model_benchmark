
; Sample runset for 180 nm
; technology
; ASSURA(r) version 3.1.6 DRC (no antenna, no density) file
; PDK version 3.3

drcExtractRules(

layerDefs("GDS2"

    BJTdum=layer( 15 type(0) )

    Bondpad=layer( 36 type(0) )

    CapMetal=layer( 14 type(0) )

    Cont=layer( 6 type(0) )

    IND2dummy=layer( 17 type(0) )

    IND3dummy=layer( 70 type(0) )

    INDdummy=layer( 16 type(0) )

    JVAR1dummy=layer( 43 type(0) )

    JVAR2dummy=layer( 44 type(0) )

    JVAR3dummy=layer( 48 type(0) )

    M1dummy=layer( 37 type(0) )

    M2dummy=layer( 38 type(0) )

    M3dummy=layer( 39 type(0) )

    M4dummy=layer( 40 type(0) )

    M5dummy=layer( 41 type(0) )

    M6dummy=layer( 42 type(0) )

    Metal1_d=layer( 7 type(0) )
    Metal1_f=layer( 7 type(5) )
    Metal1_text=textToPin( 7 type(3) )

    Metal2_d=layer( 9 type(0) )
    Metal2_f=layer( 9 type(5) )
    Metal2_text=textToPin( 9 type(3) )

    Metal3_d=layer( 11 type(0) )
    Metal3_f=layer( 11 type(5) )
    Metal3_text=textToPin( 11 type(3) )

    Metal4_d=layer( 31 type(0) )
    Metal4_f=layer( 31 type(5) )
    Metal4_text=textToPin( 31 type(3) )

    Metal5_d=layer( 33 type(0) )
    Metal5_f=layer( 33 type(5) )
    Metal5_text=textToPin( 33 type(3) )

    Metal6_d=layer( 35 type(0) )
    Metal6_f=layer( 35 type(5) )
    Metal6_text=textToPin( 35 type(3) )

    NPNdummy=layer( 20 type(0) )

    Nburied=layer( 19 type(0) )

    Nimp=layer( 4 type(0) )

    Nwell=layer( 2 type(0) )

    Oxide=layer( 1 type(0) )

    PNPdummy=layer( 21 type(0) )

    Pimp=layer( 5 type(0) )

    Poly=layer( 3 type(0) )

    Pwell=layer( 18 type(0) )

    ResWdum=layer( 71 type(0) )

    Resdum=layer( 13 type(0) )

    ThickOxide=layer( 24 type(0) )

    Via1=layer( 8 type(0) )

    Via2=layer( 10 type(0) )

    Via3=layer( 30 type(0) )

    Via4=layer( 32 type(0) )

    Via5=layer( 34 type(0) )

    bulk=cellBoundary(root)
)

layerDefs("df2"

    BJTdum=layer("BJTdum" type("drawing"))

    Bondpad=layer("Bondpad" type("drawing"))

    CapMetal=layer("CapMetal" type("drawing"))

    Cont=layer("Cont" type("drawing"))

    IND2dummy=layer("IND2dummy" type("drawing"))

    IND3dummy=layer("IND3dummy" type("drawing"))

    INDdummy=layer("INDdummy" type("drawing"))

    JVAR1dummy=layer("JVAR1dummy" type("drawing"))

    JVAR2dummy=layer("JVAR2dummy" type("drawing"))

    JVAR3dummy=layer("JVAR3dummy" type("drawing"))

    M1dummy=layer("M1dummy" type("drawing"))

    M2dummy=layer("M2dummy" type("drawing"))

    M3dummy=layer("M3dummy" type("drawing"))

    M4dummy=layer("M4dummy" type("drawing"))

    M5dummy=layer("M5dummy" type("drawing"))

    M6dummy=layer("M6dummy" type("drawing"))

    Metal1_d=layer("Metal1" type("drawing"))
    Metal1_f=layer("Metal1" type("fill"))
    Metal1_text=textToPin("Metal1" type("label"))

    Metal2_d=layer("Metal2" type("drawing"))
    Metal2_f=layer("Metal2" type("fill"))
    Metal2_text=textToPin("Metal2" type("label"))

    Metal3_d=layer("Metal3" type("drawing"))
    Metal3_f=layer("Metal3" type("fill"))
    Metal3_text=textToPin("Metal3" type("label"))

    Metal4_d=layer("Metal4" type("drawing"))
    Metal4_f=layer("Metal4" type("fill"))
    Metal4_text=textToPin("Metal4" type("label"))

    Metal5_d=layer("Metal5" type("drawing"))
    Metal5_f=layer("Metal5" type("fill"))
    Metal5_text=textToPin("Metal5" type("label"))

    Metal6_d=layer("Metal6" type("drawing"))
    Metal6_f=layer("Metal6" type("fill"))
    Metal6_text=textToPin("Metal6" type("label"))

    NPNdummy=layer("NPNdummy" type("drawing"))

    Nburied=layer("Nburied" type("drawing"))

    Nimp=layer("Nimp" type("drawing"))

    Nwell=layer("Nwell" type("drawing"))

    Oxide=layer("Oxide" type("drawing"))

    PNPdummy=layer("PNPdummy" type("drawing"))

    Pimp=layer("Pimp" type("drawing"))

    Poly=layer("Poly" type("drawing"))

    Pwell=layer("Pwell" type("drawing"))

    ResWdum=layer("ResWdum" type("drawing"))

    Resdum=layer("Resdum" type("drawing"))

    ThickOxide=layer("ThickOxide" type("drawing"))

    Via1=layer("Via1" type("drawing"))

    Via2=layer("Via2" type("drawing"))

    Via3=layer("Via3" type("drawing"))

    Via4=layer("Via4" type("drawing"))

    Via5=layer("Via5" type("drawing"))

    bulk=cellBoundary(root)
)

Metal1=geomOr(Metal1_d Metal1_f)
Metal2=geomOr(Metal2_d Metal2_f)
Metal3=geomOr(Metal3_d Metal3_f)
Metal4=geomOr(Metal4_d Metal4_f)
Metal5=geomOr(Metal5_d Metal5_f)
Metal6=geomOr(Metal6_d Metal6_f)

offGrid(BJTdum 0.005 "off grid polygon on layer BJTdum")
offGrid(Bondpad 0.005 "off grid polygon on layer Bondpad")
offGrid(CapMetal 0.005 "off grid polygon on layer CapMetal")
offGrid(Cont 0.005 "off grid polygon on layer Cont")
offGrid(IND2dummy 0.005 "off grid polygon on layer IND2dummy")
offGrid(IND3dummy 0.005 "off grid polygon on layer IND3dummy")
offGrid(INDdummy 0.005 "off grid polygon on layer INDdummy")
offGrid(JVAR1dummy 0.005 "off grid polygon on layer JVAR1dummy")
offGrid(JVAR2dummy 0.005 "off grid polygon on layer JVAR2dummy")
offGrid(JVAR3dummy 0.005 "off grid polygon on layer JVAR3dummy")
offGrid(M1dummy 0.005 "off grid polygon on layer M1dummy")
offGrid(M2dummy 0.005 "off grid polygon on layer M2dummy")
offGrid(M3dummy 0.005 "off grid polygon on layer M3dummy")
offGrid(M4dummy 0.005 "off grid polygon on layer M4dummy")
offGrid(M5dummy 0.005 "off grid polygon on layer M5dummy")
offGrid(M6dummy 0.005 "off grid polygon on layer M6dummy")
offGrid(Metal1 0.005 "off grid polygon on layer Metal1")
offGrid(Metal2 0.005 "off grid polygon on layer Metal2")
offGrid(Metal3 0.005 "off grid polygon on layer Metal3")
offGrid(Metal4 0.005 "off grid polygon on layer Metal4")
offGrid(Metal5 0.005 "off grid polygon on layer Metal5")
offGrid(Metal6 0.005 "off grid polygon on layer Metal6")
offGrid(NPNdummy 0.005 "off grid polygon on layer NPNdummy")
offGrid(Nburied 0.005 "off grid polygon on layer Nburied")
offGrid(Nimp 0.005 "off grid polygon on layer Nimp")
offGrid(Nwell 0.005 "off grid polygon on layer Nwell")
offGrid(Oxide 0.005 "off grid polygon on layer Oxide")
offGrid(PNPdummy 0.005 "off grid polygon on layer PNPdummy")
offGrid(Pimp 0.005 "off grid polygon on layer Pimp")
offGrid(Poly 0.005 "off grid polygon on layer Poly")
offGrid(Pwell 0.005 "off grid polygon on layer Pwell")
offGrid(ResWdum 0.005 "off grid polygon on layer ResWdum")
offGrid(Resdum 0.005 "off grid polygon on layer Resdum")
offGrid(ThickOxide 0.005 "off grid polygon on layer ThickOxide")
offGrid(Via1 0.005 "off grid polygon on layer Via1")
offGrid(Via2 0.005 "off grid polygon on layer Via2")
offGrid(Via3 0.005 "off grid polygon on layer Via3")
offGrid(Via4 0.005 "off grid polygon on layer Via4")
offGrid(Via5 0.005 "off grid polygon on layer Via5")

errorLayer(geomGetNon45(BJTdum) "non45 degree polygon on layer BJTdum")
errorLayer(geomGetNon45(Bondpad) "non45 degree polygon on layer Bondpad")
errorLayer(geomGetNon45(CapMetal) "non45 degree polygon on layer CapMetal")
errorLayer(geomGetNon45(Cont) "non45 degree polygon on layer Cont")
errorLayer(geomGetNon45(IND2dummy) "non45 degree polygon on layer IND2dummy")
errorLayer(geomGetNon45(IND3dummy) "non45 degree polygon on layer IND3dummy")
errorLayer(geomGetNon45(INDdummy) "non45 degree polygon on layer INDdummy")
errorLayer(geomGetNon45(JVAR1dummy) "non45 degree polygon on layer JVAR1dummy")
errorLayer(geomGetNon45(JVAR2dummy) "non45 degree polygon on layer JVAR2dummy")
errorLayer(geomGetNon45(JVAR3dummy) "non45 degree polygon on layer JVAR3dummy")
errorLayer(geomGetNon45(M1dummy) "non45 degree polygon on layer M1dummy")
errorLayer(geomGetNon45(M2dummy) "non45 degree polygon on layer M2dummy")
errorLayer(geomGetNon45(M3dummy) "non45 degree polygon on layer M3dummy")
errorLayer(geomGetNon45(M4dummy) "non45 degree polygon on layer M4dummy")
errorLayer(geomGetNon45(M5dummy) "non45 degree polygon on layer M5dummy")
errorLayer(geomGetNon45(M6dummy) "non45 degree polygon on layer M6dummy")
errorLayer(geomGetNon45(Metal1) "non45 degree polygon on layer Metal1")
errorLayer(geomGetNon45(Metal2) "non45 degree polygon on layer Metal2")
errorLayer(geomGetNon45(Metal3) "non45 degree polygon on layer Metal3")
errorLayer(geomGetNon45(Metal4) "non45 degree polygon on layer Metal4")
errorLayer(geomGetNon45(Metal5) "non45 degree polygon on layer Metal5")
errorLayer(geomGetNon45(Metal6) "non45 degree polygon on layer Metal6")
errorLayer(geomGetNon45(NPNdummy) "non45 degree polygon on layer NPNdummy")
errorLayer(geomGetNon45(Nburied) "non45 degree polygon on layer Nburied")
errorLayer(geomGetNon45(Nimp) "non45 degree polygon on layer Nimp")
errorLayer(geomGetNon45(Nwell) "non45 degree polygon on layer Nwell")
errorLayer(geomGetNon45(Oxide) "non45 degree polygon on layer Oxide")
errorLayer(geomGetNon45(PNPdummy) "non45 degree polygon on layer PNPdummy")
errorLayer(geomGetNon45(Pimp) "non45 degree polygon on layer Pimp")
errorLayer(geomGetNon45(Poly) "non45 degree polygon on layer Poly")
errorLayer(geomGetNon45(Pwell) "non45 degree polygon on layer Pwell")
errorLayer(geomGetNon45(ResWdum) "non45 degree polygon on layer ResWdum")
errorLayer(geomGetNon45(Resdum) "non45 degree polygon on layer Resdum")
errorLayer(geomGetNon45(ThickOxide) "non45 degree polygon on layer ThickOxide")
errorLayer(geomGetNon45(Via1) "non45 degree polygon on layer Via1")
errorLayer(geomGetNon45(Via2) "non45 degree polygon on layer Via2")
errorLayer(geomGetNon45(Via3) "non45 degree polygon on layer Via3")
errorLayer(geomGetNon45(Via4) "non45 degree polygon on layer Via4")
errorLayer(geomGetNon45(Via5) "non45 degree polygon on layer Via5")


drc(BJTdum width<0.01 "acute angle on layer BJTdum")
drc(IND2dummy width<0.01 "acute angle on layer IND2dummy")
drc(IND3dummy width<0.01 "acute angle on layer IND3dummy")
drc(INDdummy width<0.01 "acute angle on layer INDdummy")
drc(JVAR1dummy width<0.01 "acute angle on layer JVAR1dummy")
drc(JVAR2dummy width<0.01 "acute angle on layer JVAR2dummy")
drc(JVAR3dummy width<0.01 "acute angle on layer JVAR3dummy")
drc(M1dummy width<0.01 "acute angle on layer M1dummy")
drc(M2dummy width<0.01 "acute angle on layer M2dummy")
drc(M3dummy width<0.01 "acute angle on layer M3dummy")
drc(M4dummy width<0.01 "acute angle on layer M4dummy")
drc(M5dummy width<0.01 "acute angle on layer M5dummy")
drc(M6dummy width<0.01 "acute angle on layer M6dummy")
drc(NPNdummy width<0.01 "acute angle on layer NPNdummy")
drc(PNPdummy width<0.01 "acute angle on layer PNPdummy")
drc(ResWdum width<0.01 "acute angle on layer ResWdum")
drc(Resdum width<0.01 "acute angle on layer Resdum")


; INDterm1=INDdummy and IND2dummy
INDterm1=geomAnd(IND2dummy INDdummy)

; INDterm2=INDdummy and IND3dummy
INDterm2=geomAnd(IND3dummy INDdummy)

; M1term=Metal1 andnot M1dummy
M1term=geomAndNot(Metal1 M1dummy)

; M2term=Metal2 andnot M2dummy
M2term=geomAndNot(Metal2 M2dummy)

; M3term=Metal3 andnot M3dummy
M3term=geomAndNot(Metal3 M3dummy)

; M4term=Metal4 andnot M4dummy
M4term=geomAndNot(Metal4 M4dummy)

; M5term=Metal5 andnot M5dummy
M5term=geomAndNot(Metal5 M5dummy)

; M6term=Metal6 andnot M6dummy
M6term=geomAndNot(Metal6 M6dummy)

; NPLUS=Nimp and Oxide
NPLUS=geomAnd(Nimp Oxide)

; NSD=NPLUS andnot Poly
NSD=geomAndNot(NPLUS Poly)

; NSDcont=Cont and NPLUS
NSDcont=geomAnd(Cont NPLUS)

; NSDterm=NSD andnot Resdum
NSDterm=geomAndNot(NSD Resdum)

; NWELLterm=Nwell andnot ResWdum
NWELLterm=geomAndNot(Nwell ResWdum)

; NBVIA=NWELLterm and Nburied
NBVIA=geomAnd(NWELLterm Nburied)

; NWVIA=NSDterm and NWELLterm
NWVIA=geomAnd(NSDterm NWELLterm)

; POLYcont=Cont and Poly
POLYcont=geomAnd(Cont Poly)

; POLYterm=Poly andnot Resdum
POLYterm=geomAndNot(Poly Resdum)

; PPLUS=Pimp and Oxide
PPLUS=geomAnd(Oxide Pimp)

; PSD=PPLUS andnot Poly
PSD=geomAndNot(PPLUS Poly)

; PSDcont=Cont and PPLUS
PSDcont=geomAnd(Cont PPLUS)

; PSDterm=PSD andnot Resdum
PSDterm=geomAndNot(PSD Resdum)

; Via2Cap=Via2 and CapMetal
Via2Cap=geomAnd(CapMetal Via2)

; INDterm1Cont=Metal2 and INDdummy and IND2dummy
L41497=geomAnd(INDdummy Metal2)
INDterm1Cont=geomAnd(IND2dummy L41497)

; INDterm2Cont=Metal2 and INDdummy and IND3dummy
INDterm2Cont=geomAnd(IND3dummy L41497)

; JVARanode=(JVAR1dummy or JVAR2dummy) andnot NSDterm
L74850=geomOr(JVAR1dummy JVAR2dummy)
JVARanode=geomAndNot(L74850 NSDterm)

; NSDarea=(NPLUS cut Poly) andnot Poly
L61090=geomStraddle(NPLUS Poly)
NSDarea=geomAndNot(L61090 Poly)

; PSDarea=(PPLUS cut Poly) andnot Poly
L34080=geomStraddle(PPLUS Poly)
PSDarea=geomAndNot(L34080 Poly)

; PWVIA=(PSDterm and Pwell) andnot Nwell
L33566=geomAnd(PSDterm Pwell)
PWVIA=geomAndNot(L33566 Nwell)

; JVARterm=PSDterm and (JVAR1dummy or JVAR2dummy) and JVAR3dummy
L40384=geomAnd(L74850 PSDterm)
JVARterm=geomAnd(JVAR3dummy L40384)

; Via2NoCapInd=Via2 and Metal2 andnot (CapMetal or INDdummy)
L98704=geomAnd(Metal2 Via2)
L47735=geomOr(CapMetal INDdummy)
Via2NoCapInd=geomAndNot(L98704 L47735)

; PSUB=(bulk andnot (Nburied or Nwell or Pwell)) or BJTdum
L43094=geomOr(Nburied Nwell)
L15547=geomOr(L43094 Pwell)
L71054=geomAndNot(bulk L15547)
PSUB=geomOr(BJTdum L71054)

; SUBVIA=(PSUB and PSDterm) andnot Nburied andnot Nwell
L6892=geomAnd(PSDterm PSUB)
L56122=geomAndNot(L6892 Nburied)
SUBVIA=geomAndNot(L56122 Nwell)

; ISOPWELL=((Nburied enclose (holes Nwell)) and (holes Nwell))andnot Pwell
L85630=geomHoles(Nwell)
L90545=geomAndNot(L85630 Nwell)
L50707=geomEnclose(Nburied L90545)
L9133=geomAnd(L50707 L90545)
ISOPWELL=geomAndNot(L9133 Pwell)

; PWNBVIA=(PSDterm and ISOPWELL)
PWNBVIA=geomAnd(ISOPWELL PSDterm)

geomConnect(
    via(Via5 M6term M5term)
    via(Via4 M5term M4term)
    via(Via3 M4term M3term)
    via(Via2NoCapInd M3term M2term)
    via(Via2Cap M3term CapMetal)
    via(Via1 M2term M1term)
    via(INDterm1Cont M2term INDterm1)
    via(INDterm2Cont M2term INDterm2)
    via(POLYcont M1term POLYterm)
    via(PSDcont M1term PSDterm)
    via(NSDcont M1term NSDterm)
    label(Metal6_text M6term)
    label(Metal5_text M5term)
    label(Metal4_text M4term)
    label(Metal3_text M3term)
    label(Metal2_text M2term)
    label(Metal1_text M1term)
)
geomStamp(NWVIA NSDterm multStamp floating)
geomStamp(NWELLterm NWVIA multStamp floating)
geomStamp(JVARterm PSDterm multStamp floating)
geomStamp(JVARanode JVARterm multStamp floating)
geomStamp(PWVIA PSDterm multStamp floating)
geomStamp(Pwell PWVIA multStamp floating)
geomStamp(PWNBVIA PSDterm multStamp floating)
geomStamp(ISOPWELL PWNBVIA multStamp floating)
geomStamp(SUBVIA PSDterm multStamp floating)
geomStamp(PSUB SUBVIA multStamp floating)
geomStamp(NBVIA NWELLterm multStamp floating)
geomStamp(Nburied NBVIA multStamp floating)


L43256=drc(Nburied width<1.0)
errorLayer(L43256 "0A: Nburied width must be >= 1.0 um")

L90492=drc(Nburied sepNotch<1.0)
errorLayer(L90492 "0B: Nburied to Nburied spacing must be >= 1.0 um")

L51235=drc(Nwell width<1.0)
errorLayer(L51235 "1A: Nwell width must be >= 1.0 um")

L94017=drc(Nwell sepNotch<1.0)
errorLayer(L94017 "1B: Nwell to Nwell spacing must be >= 1.0 um")

L91414=drc(Nburied Nwell enc<0.3)
errorLayer(L91414 "1C: Nburied to Nwell enclosure must be >= 0.3 um")

L82881=drc(Pwell width<1.0)
errorLayer(L82881 "1D: Pwell width must be >= 1.0 um")

L49725=drc(Pwell sepNotch<1.0)
errorLayer(L49725 "1E: Pwell to Pwell spacing must be >= 1.0 um")

L66025=geomStraddle(Pwell Nburied)
L7227=geomAndNot(L66025 Nburied)
errorLayer(L7227 "1F: Nburied to Pwell enclosure must be >= 0.3 um")
L25836=drc(Nburied Pwell enc<0.3)
errorLayer(L25836 "1F: Nburied to Pwell enclosure must be >= 0.3 um")

L49723=drc(Oxide width<0.4)
errorLayer(L49723 "2A: Oxide width must be >= 0.4 um")

L30364=drc(Oxide sepNotch<0.3)
errorLayer(L30364 "2B: Oxide to Oxide spacing must be >= 0.3 um")

L92079=geomStraddle(Oxide Nwell)
L94544=geomAndNot(L92079 Nwell)
errorLayer(L94544 "2C: Nwell to Oxide enclosure must be >= 0.5 um")
L95670=drc(Nwell Oxide enc<0.5)
errorLayer(L95670 "2C: Nwell to Oxide enclosure must be >= 0.5 um")

L16915=geomStraddle(Oxide Pwell)
L83153=geomAndNot(L16915 Pwell)
errorLayer(L83153 "2C: Pwell to Oxide enclosure must be >= 0.5 um")
L44120=drc(Pwell Oxide enc<0.5)
errorLayer(L44120 "2C: Pwell to Oxide enclosure must be >= 0.5 um")

L51985=geomStraddle(Nwell Oxide)
L60919=geomAnd(L51985 L92079)
errorLayer(L60919 "2D: Nwell to Oxide spacing must be >= 0.5 um")
L74330=drc(Nwell Oxide sep<0.5)
errorLayer(L74330 "2D: Nwell to Oxide spacing must be >= 0.5 um")

L86547=geomStraddle(Pwell Oxide)
L75276=geomAnd(L16915 L86547)
errorLayer(L75276 "2D: Pwell to Oxide spacing must be >= 0.5 um")
L19004=drc(Oxide Pwell sep<0.5)
errorLayer(L19004 "2D: Pwell to Oxide spacing must be >= 0.5 um")

L71151=drc(ThickOxide width<0.5)
errorLayer(L71151 "2.5A: ThickOxide width must be >= 0.5 um")

L9068=drc(ThickOxide sepNotch<0.4)
errorLayer(L9068 "2.5B: ThickOxide to ThickOxide spacing must be >= 0.4 um")

L41568=drc(Oxide ThickOxide sep<0.25)
errorLayer(L41568 "2.5D: ThickOxide to Oxide spacing must be >= 0.25 um")

L50103=geomGetEdge(Poly inside Oxide)
L35487=geomGetEdge(ThickOxide inside Oxide)
L93599=geomSize(L50103 -0.005 edges)
L51289=geomSize(L35487 -0.005 edges)
L9682=geomAnd(L51289 L93599)
errorLayer(L9682 "2.5E: ThickOxide to Poly spacing must be >= 0.4 um")
L75860=drc(L50103 L35487 sep<0.4)
errorLayer(L75860 "2.5E: ThickOxide to Poly spacing must be >= 0.4 um")

L73228=geomSize(L35487 0.005 edges)
L62697=geomAnd(L73228 L93599)
errorLayer(L62697 "2.5F: ThickOxide to Poly enclosure must be >= 0.4 um")
L71424=drc(L35487 L50103 enc<0.4)
errorLayer(L71424 "2.5F: ThickOxide to Poly enclosure must be >= 0.4 um")

L7458=drc(ThickOxide Oxide enc<0.25)
errorLayer(L7458 "2.5C: ThickOxide to Oxide enclosure must be >= 0.25 um")

L60984=drc(Nimp width<0.4)
errorLayer(L60984 "3A: Nimp width must be >= 0.4 um")

L80794=drc(Nimp sepNotch<0.4)
errorLayer(L80794 "3B: Nimp to Nimp spacing must be >= 0.4 um")

L82011=drc(Nimp Oxide enc<0.2)
errorLayer(L82011 "3C: Nimp to Oxide enclosure must be >= 0.2 um")

L86745=drc(Nburied Nimp enc<0.6)
errorLayer(L86745 "3D: Nburied to Nimp enclosure must be >= 0.6 um")

L97306=drc(Pimp width<0.4)
errorLayer(L97306 "4A: Pimp width must be >= 0.4 um")

L41796=drc(Pimp sepNotch<0.4)
errorLayer(L41796 "4B: Pimp to Pimp spacing must be >= 0.4 um")

L41543=drc(Pimp Oxide enc<0.2)
errorLayer(L41543 "4C: Pimp to Oxide enclosure must be >= 0.2 um")

L19269=drc(Nburied Pimp enc<0.6)
errorLayer(L19269 "4D: Nburied to Pimp enclosure must be >= 0.6 um")

L85453=drc(Poly width<0.18)
errorLayer(L85453 "5A: Poly width must be >= 0.18 um")

L63925=drc(Poly sepNotch<0.3)
errorLayer(L63925 "5B: Poly to Poly spacing must be >= 0.3 um")

L92023=drc(Poly Oxide enc<0.2)
errorLayer(L92023 "5C: Poly to Oxide enclosure must be >= 0.2 um")

L84361=drc(Oxide Poly enc<0.4)
errorLayer(L84361 "5D: Oxide to Poly enclosure must be >= 0.4 um")

L4213=drc(Oxide Poly sep<0.2)
errorLayer(L4213 "5E: Oxide to Poly spacing must be >= 0.2 um")

L9788=drc(Cont sepNotch<0.2)
errorLayer(L9788 "6B: Cont to Cont spacing must be >= 0.2 um")

L63235=geomContactCheck(Cont width==0.2 length==0.2 ignore)
errorLayer(L63235 "6A: Cont shapes must be 0.2x0.2 rectangles")

L47091=geomStraddle(Cont Oxide)
