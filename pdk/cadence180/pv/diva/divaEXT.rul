copyGraphics(("Metal1" "label") all)
copyGraphics(("Metal2" "label") all)
copyGraphics(("Metal3" "label") all)
copyGraphics(("Metal4" "label") all)
copyGraphics(("Metal5" "label") all)
copyGraphics(("Metal6" "label") all)

extractDevice(POLYRES (POLYterm "PLUS") (POLYterm "MINUS")
    "polyres ivpcell gpdk180" physical)
width=measureParameter(length (POLYRES butting POLYterm) 0.5)
length=measureParameter(length (POLYRES outside POLYterm) 0.5)
w=calculateParameter(width*1e-6)
saveParameter(w "w")
l=calculateParameter(length*1e-6)
saveParameter(l "l")
sl=calculateParameter(length*1e-6)
saveParameter(sl "sl")
r=calculateParameter(7.5*length/width)
saveParameter(r "r")
saveRecognition(POLYRES "Poly")

extractDevice(POLYHRES (POLYterm "PLUS") (POLYterm "MINUS")
    "polyhres ivpcell gpdk180" physical)
width=measureParameter(length (POLYHRES butting POLYterm) 0.5)
length=measureParameter(length (POLYHRES outside POLYterm) 0.5)
w=calculateParameter(width*1e-6)
