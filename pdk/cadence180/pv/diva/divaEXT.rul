l=calculateParameter(length*1e-6)
saveParameter(l "l")
sl=calculateParameter(length*1e-6)
saveParameter(sl "sl")
r=calculateParameter(352*length/width)
saveParameter(r "r")
saveRecognition(POLYHRES "Poly")

extractDevice(NSDRES (NSDterm "PLUS") (NSDterm "MINUS") (PSUB "B")
    "nplusres ivpcell gpdk180" physical)
