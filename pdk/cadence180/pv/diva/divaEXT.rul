saveDerived(Metal4 ("Metal4" "drawing") ext_view)
saveDerived(Metal5 ("Metal5" "drawing") ext_view)
saveDerived(Metal6 ("Metal6" "drawing") ext_view)
saveDerived(NPNdummy ("NPNdummy" "drawing") ext_view)
