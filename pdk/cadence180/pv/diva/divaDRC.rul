BJTdum=geomOr(("BJTdum" "drawing"))

Bondpad=geomOr(("Bondpad" "drawing"))

CapMetal=geomOr(("CapMetal" "drawing"))

Cont=geomOr(("Cont" "drawing"))

IND2dummy=geomOr(("IND2dummy" "drawing"))

IND3dummy=geomOr(("IND3dummy" "drawing"))

INDdummy=geomOr(("INDdummy" "drawing"))

JVAR1dummy=geomOr(("JVAR1dummy" "drawing"))

JVAR2dummy=geomOr(("JVAR2dummy" "drawing"))

JVAR3dummy=geomOr(("JVAR3dummy" "drawing"))

M1dummy=geomOr(("M1dummy" "drawing"))

M2dummy=geomOr(("M2dummy" "drawing"))

M3dummy=geomOr(("M3dummy" "drawing"))

M4dummy=geomOr(("M4dummy" "drawing"))

M5dummy=geomOr(("M5dummy" "drawing"))

M6dummy=geomOr(("M6dummy" "drawing"))

Metal1_d=geomOr(("Metal1" "drawing"))
Metal1_f=geomOr(("Metal1" "fill"))
Metal1=geomOr(Metal1_d Metal1_f)

Metal2_d=geomOr(("Metal2" "drawing"))
Metal2_f=geomOr(("Metal2" "fill"))
Metal2=geomOr(Metal2_d Metal2_f)

Metal3_d=geomOr(("Metal3" "drawing"))
Metal3_f=geomOr(("Metal3" "fill"))
Metal3=geomOr(Metal3_d Metal3_f)

Metal4_d=geomOr(("Metal4" "drawing"))
Metal4_f=geomOr(("Metal4" "fill"))
Metal4=geomOr(Metal4_d Metal4_f)

Metal5_d=geomOr(("Metal5" "drawing"))
Metal5_f=geomOr(("Metal5" "fill"))
Metal5=geomOr(Metal5_d Metal5_f)

Metal6_d=geomOr(("Metal6" "drawing"))
Metal6_f=geomOr(("Metal6" "fill"))
Metal6=geomOr(Metal6_d Metal6_f)

NPNdummy=geomOr(("NPNdummy" "drawing"))

Nburied=geomOr(("Nburied" "drawing"))

Nimp=geomOr(("Nimp" "drawing"))

Nwell=geomOr(("Nwell" "drawing"))

Oxide=geomOr(("Oxide" "drawing"))

PNPdummy=geomOr(("PNPdummy" "drawing"))

Pimp=geomOr(("Pimp" "drawing"))

Poly=geomOr(("Poly" "drawing"))

Pwell=geomOr(("Pwell" "drawing"))

ResWdum=geomOr(("ResWdum" "drawing"))

Resdum=geomOr(("Resdum" "drawing"))

ThickOxide=geomOr(("ThickOxide" "drawing"))

Via1=geomOr(("Via1" "drawing"))

Via2=geomOr(("Via2" "drawing"))

Via3=geomOr(("Via3" "drawing"))

Via4=geomOr(("Via4" "drawing"))

Via5=geomOr(("Via5" "drawing"))

bulk=geomBkgnd(0)

; INDterm1=INDdummy and IND2dummy
INDterm1=geomAnd(IND2dummy INDdummy)

; INDterm2=INDdummy and IND3dummy
INDterm2=geomAnd(IND3dummy INDdummy)

; M1term=Metal1 andnot M1dummy
M1term=geomAndNot(Metal1 M1dummy)

; M2term=Metal2 andnot M2dummy
M2term=geomAndNot(Metal2 M2dummy)

; M3term=Metal3 andnot M3dummy
M3term=geomAndNot(Metal3 M3dummy)

; M4term=Metal4 andnot M4dummy
M4term=geomAndNot(Metal4 M4dummy)

; M5term=Metal5 andnot M5dummy
M5term=geomAndNot(Metal5 M5dummy)

; M6term=Metal6 andnot M6dummy
M6term=geomAndNot(Metal6 M6dummy)

; NPLUS=Nimp and Oxide
NPLUS=geomAnd(Nimp Oxide)

; NSD=NPLUS andnot Poly
NSD=geomAndNot(NPLUS Poly)

; NSDcont=Cont and NPLUS
NSDcont=geomAnd(Cont NPLUS)

; NSDterm=NSD andnot Resdum
NSDterm=geomAndNot(NSD Resdum)

; NWELLterm=Nwell andnot ResWdum
NWELLterm=geomAndNot(Nwell ResWdum)

; NBVIA=NWELLterm and Nburied
NBVIA=geomAnd(NWELLterm Nburied)

; NWVIA=NSDterm and NWELLterm
NWVIA=geomAnd(NSDterm NWELLterm)

; POLYcont=Cont and Poly
POLYcont=geomAnd(Cont Poly)

; POLYterm=Poly andnot Resdum
POLYterm=geomAndNot(Poly Resdum)

; PPLUS=Pimp and Oxide
PPLUS=geomAnd(Oxide Pimp)

; PSD=PPLUS andnot Poly
PSD=geomAndNot(PPLUS Poly)

; PSDcont=Cont and PPLUS
PSDcont=geomAnd(Cont PPLUS)

; PSDterm=PSD andnot Resdum
PSDterm=geomAndNot(PSD Resdum)

; Via2Cap=Via2 and CapMetal
Via2Cap=geomAnd(CapMetal Via2)

; INDterm1Cont=Metal2 and INDdummy and IND2dummy
L41497=geomAnd(INDdummy Metal2)
INDterm1Cont=geomAnd(IND2dummy L41497)

; INDterm2Cont=Metal2 and INDdummy and IND3dummy
INDterm2Cont=geomAnd(IND3dummy L41497)

; JVARanode=(JVAR1dummy or JVAR2dummy) andnot NSDterm
L74850=geomOr(JVAR1dummy JVAR2dummy)
JVARanode=geomAndNot(L74850 NSDterm)

; NSDarea=(NPLUS cut Poly) andnot Poly
L61090=geomStraddle(NPLUS Poly)
NSDarea=geomAndNot(L61090 Poly)

; PSDarea=(PPLUS cut Poly) andnot Poly
L34080=geomStraddle(PPLUS Poly)
PSDarea=geomAndNot(L34080 Poly)

; PWVIA=(PSDterm and Pwell) andnot Nwell
L33566=geomAnd(PSDterm Pwell)
PWVIA=geomAndNot(L33566 Nwell)

; JVARterm=PSDterm and (JVAR1dummy or JVAR2dummy) and JVAR3dummy
L40384=geomAnd(L74850 PSDterm)
JVARterm=geomAnd(JVAR3dummy L40384)

; Via2NoCapInd=Via2 and Metal2 andnot (CapMetal or INDdummy)
L98704=geomAnd(Metal2 Via2)
L47735=geomOr(CapMetal INDdummy)
Via2NoCapInd=geomAndNot(L98704 L47735)

; PSUB=(bulk andnot (Nburied or Nwell or Pwell)) or BJTdum
L43094=geomOr(Nburied Nwell)
L15547=geomOr(L43094 Pwell)
L71054=geomAndNot(bulk L15547)
PSUB=geomOr(BJTdum L71054)

; SUBVIA=(PSUB and PSDterm) andnot Nburied andnot Nwell
L6892=geomAnd(PSDterm PSUB)
L56122=geomAndNot(L6892 Nburied)
SUBVIA=geomAndNot(L56122 Nwell)

; ISOPWELL=((Nburied enclose (holes Nwell)) and (holes Nwell))andnot Pwell
L90545=geomHoles(Nwell voids)
L50707=geomEnclose(Nburied L90545)
L9133=geomAnd(L50707 L90545)
ISOPWELL=geomAndNot(L9133 Pwell)

; PWNBVIA=(PSDterm and ISOPWELL)
PWNBVIA=geomAnd(ISOPWELL PSDterm)

geomConnect(
    via(Via5 M6term M5term)
    via(Via4 M5term M4term)
    via(Via3 M4term M3term)
    via(Via2NoCapInd M3term M2term)
    via(Via2Cap M3term CapMetal)
    via(Via1 M2term M1term)
    via(INDterm1Cont M2term INDterm1)
    via(INDterm2Cont M2term INDterm2)
    via(POLYcont M1term POLYterm)
    via(PSDcont M1term PSDterm)
    via(NSDcont M1term NSDterm)
    label(("Metal6" "label") M6term)
    label(("Metal5" "label") M5term)
    label(("Metal4" "label") M4term)
    label(("Metal3" "label") M3term)
    label(("Metal2" "label") M2term)
    label(("Metal1" "label") M1term)
)
NWVIA=geomStamp(NWVIA NSDterm error)
NWELLterm=geomStamp(NWELLterm NWVIA error)
JVARterm=geomStamp(JVARterm PSDterm error)
JVARanode=geomStamp(JVARanode JVARterm error)
PWVIA=geomStamp(PWVIA PSDterm error)
Pwell=geomStamp(Pwell PWVIA error)
PWNBVIA=geomStamp(PWNBVIA PSDterm error)
ISOPWELL=geomStamp(ISOPWELL PWNBVIA error)
SUBVIA=geomStamp(SUBVIA PSDterm error)
PSUB=geomStamp(PSUB SUBVIA error)
NBVIA=geomStamp(NBVIA NWELLterm error)
Nburied=geomStamp(Nburied NBVIA error)


drc(Nburied width<1.0 "0A: Nburied width must be >= 1.0 um")

drc(Nburied sep<1.0 "0B: Nburied to Nburied spacing must be >= 1.0 um")
drc(Nburied notch<1.0 "0B: Nburied to Nburied spacing must be >= 1.0 um")

drc(Nwell width<1.0 "1A: Nwell width must be >= 1.0 um")

drc(Nwell sep<1.0 "1B: Nwell to Nwell spacing must be >= 1.0 um")
drc(Nwell notch<1.0 "1B: Nwell to Nwell spacing must be >= 1.0 um")

drc(Nburied Nwell enc<0.3 "1C: Nburied to Nwell enclosure must be >= 0.3 um")

drc(Pwell width<1.0 "1D: Pwell width must be >= 1.0 um")

drc(Pwell sep<1.0 "1E: Pwell to Pwell spacing must be >= 1.0 um")
drc(Pwell notch<1.0 "1E: Pwell to Pwell spacing must be >= 1.0 um")

L66025=geomStraddle(Pwell Nburied)
L7227=geomAndNot(L66025 Nburied)
saveDerived(L7227 "1F: Nburied to Pwell enclosure must be >= 0.3 um")
drc(Nburied Pwell enc<0.3 "1F: Nburied to Pwell enclosure must be >= 0.3 um")

drc(Oxide width<0.4 "2A: Oxide width must be >= 0.4 um")

drc(Oxide sep<0.3 "2B: Oxide to Oxide spacing must be >= 0.3 um")
drc(Oxide notch<0.3 "2B: Oxide to Oxide spacing must be >= 0.3 um")

L92079=geomStraddle(Oxide Nwell)
L94544=geomAndNot(L92079 Nwell)
saveDerived(L94544 "2C: Nwell to Oxide enclosure must be >= 0.5 um")
drc(Nwell Oxide enc<0.5 "2C: Nwell to Oxide enclosure must be >= 0.5 um")

L16915=geomStraddle(Oxide Pwell)
L83153=geomAndNot(L16915 Pwell)
saveDerived(L83153 "2C: Pwell to Oxide enclosure must be >= 0.5 um")
drc(Pwell Oxide enc<0.5 "2C: Pwell to Oxide enclosure must be >= 0.5 um")

L51985=geomStraddle(Nwell Oxide)
L60919=geomAnd(L51985 L92079)
saveDerived(L60919 "2D: Nwell to Oxide spacing must be >= 0.5 um")
drc(Nwell Oxide sep<0.5 "2D: Nwell to Oxide spacing must be >= 0.5 um")

L86547=geomStraddle(Pwell Oxide)
L75276=geomAnd(L16915 L86547)
saveDerived(L75276 "2D: Pwell to Oxide spacing must be >= 0.5 um")
drc(Oxide Pwell sep<0.5 "2D: Pwell to Oxide spacing must be >= 0.5 um")

drc(ThickOxide width<0.5 "2.5A: ThickOxide width must be >= 0.5 um")

drc(ThickOxide sep<0.4
    "2.5B: ThickOxide to ThickOxide spacing must be >= 0.4 um")
drc(ThickOxide notch<0.4
    "2.5B: ThickOxide to ThickOxide spacing must be >= 0.4 um")

drc(Oxide ThickOxide sep<0.25
    "2.5D: ThickOxide to Oxide spacing must be >= 0.25 um")

L50103=geomGetEdge(Poly inside Oxide)
L35487=geomGetEdge(ThickOxide inside Oxide)
L347=geomSize(L50103 -0.001 edges)
L22755=geomSize(L35487 -0.001 edges)
L74601=geomAnd(L22755 L347)
saveDerived(L74601 "2.5E: ThickOxide to Poly spacing must be >= 0.4 um")
drc(L50103 L35487 sep<0.4 "2.5E: ThickOxide to Poly spacing must be >= 0.4 um")

L816=geomSize(L35487 0.001 edges)
L77425=geomAnd(L347 L816)
saveDerived(L77425 "2.5F: ThickOxide to Poly enclosure must be >= 0.4 um")
drc(L35487 L50103 enc<0.4
    "2.5F: ThickOxide to Poly enclosure must be >= 0.4 um")

drc(ThickOxide Oxide enc<0.25
