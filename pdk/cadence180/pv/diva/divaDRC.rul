dubiousData(("BJTdum" "drawing") "badly formed polygon on layer BJTdum")
dubiousData(("Bondpad" "drawing") "badly formed polygon on layer Bondpad")
dubiousData(("CapMetal" "drawing") "badly formed polygon on layer CapMetal")
