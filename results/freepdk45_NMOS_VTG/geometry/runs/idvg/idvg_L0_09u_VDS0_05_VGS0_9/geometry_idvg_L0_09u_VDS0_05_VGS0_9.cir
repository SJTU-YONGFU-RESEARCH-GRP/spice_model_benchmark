* Geometry OP check netlist (template)

.option gmin=1e-15
.include "../../../../../../models/FreePDK45/tran_models/models_nom/NMOS_VTG.inc"
.option reltol=1e-8
.option abstol=1e-12
.option chgtol=1e-15
.option method=gear
.option TEMP=27
.option TNOM=27
.option TEMPSCALE=1.0

* MOSFET device under test
M1 drain_geo gate_geo source_geo bulk_geo NMOS_VTG L=0.09u W=10u

* Bias sources
Vds_geo drain_geo 0 DC 0.05
Vgs_geo gate_geo 0 DC 0.9
Vs_geo source_geo 0 DC 0
Vb_geo bulk_geo 0 DC 0

.control
set filetype=ascii
set wr_vecnames
set wr_singlescale
set wr_formatted

option temp=27

echo "W L VDS VGS IDS" > ./geometry_op_idvg_L0_09u_VDS0_05_VGS0_9.txt

op

let ids = abs(i(Vds_geo))

echo "10u 0.09u 0.05 0.9 $&ids" >> ./geometry_op_idvg_L0_09u_VDS0_05_VGS0_9.txt

quit
.endc

.end
